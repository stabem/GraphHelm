.DS_Store
Thumbs.db
*.tmp
*.log
__pycache__/
.worktrees/
target/
*.jsonl
# The local Runtime state directory a developer or a session creates in the repository root:
# the serve token, the sealed broker credential store, the keyring and the live event stores.
# It was NOT ignored, and a single "git add -A" in a session worktree staged
# .graphhelm/broker/credentials.json, .graphhelm/serve.key and both event-store tokens.
# Caught before any push (#1184), which is luck rather than a safeguard: untracked is not a
# guard, an ignore rule is.
/.graphhelm/*
# Per-machine Desktop team binding stores local paths and is never shared.
/.graphhelm/team.json
# ...except the journey-flow sources, which are the project's own user-journey map (#368) and
# carry no secret: names only, never a token or a key value (journey-explore design, section 11).
!/.graphhelm/journeys/
# The launcher `journey watch` runs when the app under test is down (#462): committed config.
!/.graphhelm/journey-fixture.json
/.graphhelm/journeys/*
!/.graphhelm/journeys/*.journey.yaml
# The retired gate runner (deleted in #1204) wrote its run manifests under .factory/gate-runs/;
# the receipt store and the runners that committed it were retired on 2026-09-24. The prefix stays
# ignored so an old local run's manifest is never committed.
/.factory/
**/evals/results/

# Playwright for `graphhelm journey replay` is installed at the repository root with --no-save (#381).
/node_modules/
# The Claude Code harness writes this per-machine file into every worktree it creates; an untracked
# copy made run_reached.py refuse the worktree as not clean (#1538).
/.claude/settings.local.json
