# Generated by npm, tsc, and vite. Nothing here belongs in the repository: it is all
# reproducible from package-lock.json plus `npm ci && npm run build`.
node_modules/
dist/
*.tsbuildinfo
# tsc's own emitted siblings of the config files, if a build is ever run without --noEmit.
vite.config.js
vite.config.d.ts
# Local Runtime coordinates: one operator's machine, never the repository.
.env.local
