+```powershell
+$d = git diff -U0 -- apps/cli/src/commands/execution/mod.rs apps/cli/src/commands/mcp/tools.rs
+$removed = $d | Where-Object { $_ -match '^-'  -and $_ -notmatch '^---' } | ForEach-Object { $_.Substring(1) } | Sort-Object
+$added   = $d | Where-Object { $_ -match '^\+' -and $_ -notmatch '^\+\+\+' } | ForEach-Object { $_.Substring(1) } | Sort-Object
