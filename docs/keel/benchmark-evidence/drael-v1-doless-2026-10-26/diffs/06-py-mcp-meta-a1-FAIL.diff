+    def test_mcp_tools_call_accepts_meta_object_and_rejects_non_object_meta(self):
+        env = os.environ.copy(); env.update(self.env)
+        env["GRAPHHELM_MCP_HOST"] = "codex"
+        env["GRAPHHELM_SESSION_ID"] = "receiver-1"
+        with_meta = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call",
+                                "params": {"name": "status", "arguments": {},
+                                           "_meta": {"progressToken": "pt-1"}}})
+        bad_meta = json.dumps({"jsonrpc": "2.0", "id": 2, "method": "tools/call",
+                               "params": {"name": "status", "arguments": {}, "_meta": "pt-1"}})
+        result = subprocess.run([sys.executable, str(SCRIPT), "--mcp-stdio"], env=env,
+                                input=with_meta + "\n" + bad_meta + "\n", capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        replies = [json.loads(line) for line in result.stdout.splitlines()]
+        self.assertFalse(replies[0]["result"]["isError"])
+        self.assertEqual(replies[0]["result"]["content"][0]["type"], "text")
+        self.assertEqual(replies[1]["error"]["code"], -32602)
+
