+    def test_mcp_accepts_object_meta_and_rejects_non_object_meta(self):
+        env = os.environ.copy(); env.update(self.env)
+        env["GRAPHHELM_MCP_HOST"] = "codex"
+        env["GRAPHHELM_SESSION_ID"] = "receiver-1"
+        before = len(RuntimeHandler.requests)
+        payload = "\n".join([
+            json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call",
+                        "params": {"name": "status", "arguments": {}, "_meta": "not-an-object"}}),
+            json.dumps({"jsonrpc": "2.0", "id": 2, "method": "tools/call",
+                        "params": {"name": "status", "arguments": {},
+                                   "_meta": {"progressToken": "pt-1"}}}),
+        ]) + "\n"
+        result = subprocess.run([sys.executable, str(SCRIPT), "--mcp-stdio"], env=env,
+                                input=payload, capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        replies = [json.loads(line) for line in result.stdout.splitlines()]
+        self.assertEqual(len(replies), 2)
+        self.assertEqual(replies[0]["id"], 1)
+        self.assertEqual(replies[0]["error"]["code"], -32602)
+        self.assertFalse(replies[1]["result"]["isError"])
+        body = json.loads(replies[1]["result"]["content"][0]["text"])
+        self.assertEqual(body["phase"], "status")
+        # The non-object _meta call was refused before dispatch; only the accepted call reached the Runtime.
+        self.assertEqual(len(RuntimeHandler.requests), before + 1)
+
     def test_mcp_rejects_identity_override_and_oversized_request_before_runtime_io(self):
