+    def test_mcp_stdio_accepts_meta_object_and_rejects_non_object_or_unknown_params(self):
+        env = os.environ.copy(); env.update(self.env)
+        env["GRAPHHELM_MCP_HOST"] = "codex"
+        env["GRAPHHELM_SESSION_ID"] = "receiver-1"
+        payload = "\n".join([
+            json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}}),
+            json.dumps({"jsonrpc": "2.0", "id": 2, "method": "tools/call",
+                        "params": {"name": "status", "arguments": {}, "_meta": {"progressToken": "tok-1"}}}),
+            json.dumps({"jsonrpc": "2.0", "id": 3, "method": "tools/call",
+                        "params": {"name": "status", "arguments": {}, "_meta": "progress-1"}}),
+            json.dumps({"jsonrpc": "2.0", "id": 4, "method": "tools/call",
+                        "params": {"name": "status", "arguments": {}, "_meta": {}, "note": "extra"}}),
+        ]) + "\n"
+        result = subprocess.run([sys.executable, str(SCRIPT), "--mcp-stdio"], env=env,
+                                input=payload, capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        replies = [json.loads(line) for line in result.stdout.splitlines()]
+        self.assertFalse(replies[1]["result"]["isError"])
+        self.assertEqual(replies[1]["result"]["content"][0]["type"], "text")
+        self.assertEqual(replies[2]["error"]["code"], -32602)
+        self.assertEqual(replies[3]["error"]["code"], -32602)
+
