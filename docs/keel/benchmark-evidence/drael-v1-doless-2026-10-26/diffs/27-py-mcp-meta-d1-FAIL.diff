+    def test_mcp_stdio_accepts_meta_object_and_rejects_meta_that_is_not_an_object(self):
+        env = os.environ.copy(); env.update(self.env)
+        env["GRAPHHELM_MCP_HOST"] = "codex"
+        env["GRAPHHELM_SESSION_ID"] = "receiver-1"
+        accepted = {"jsonrpc": "2.0", "id": 1, "method": "tools/call",
+                    "params": {"name": "status", "arguments": {}, "_meta": {"progressToken": 7}}}
+        result = subprocess.run([sys.executable, str(SCRIPT), "--mcp-stdio"], env=env,
+                                input=json.dumps(accepted) + "\n", capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        replies = [json.loads(line) for line in result.stdout.splitlines()]
+        self.assertFalse(replies[0]["result"]["isError"])
+        self.assertEqual(replies[0]["result"]["content"][0]["type"], "text")
+        before = len(RuntimeHandler.requests)
+        rejected = {"jsonrpc": "2.0", "id": 2, "method": "tools/call",
+                    "params": {"name": "status", "arguments": {}, "_meta": "progress"}}
+        result = subprocess.run([sys.executable, str(SCRIPT), "--mcp-stdio"], env=env,
+                                input=json.dumps(rejected) + "\n", capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        replies = [json.loads(line) for line in result.stdout.splitlines()]
+        self.assertEqual(replies[0]["error"]["code"], -32602)
+        self.assertEqual(len(RuntimeHandler.requests), before)
+
