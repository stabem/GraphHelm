+def test_run_agent_sends_unicode_prompt_on_legacy_windows_code_page(tmp_path, monkeypatch):
+    """A cp1252 host raised UnicodeEncodeError writing a non-ASCII prompt to the child's
+    stdin pipe before run_agent pinned an explicit utf-8 encoding."""
+    monkeypatch.setattr(locale, "getencoding", lambda: "cp1252")
+    echo_script = tmp_path / "fake_claude.py"
+    echo_script.write_text(
+        "import sys, json\n"
+        "data = sys.stdin.buffer.read().decode('utf-8')\n"
+        "print(json.dumps({'echo': data}))\n",
+        encoding="utf-8",
+    )
+    wrapper = tmp_path / "fake_claude.bat"
+    wrapper.write_text(f'@echo off\r\n"{sys.executable}" "{echo_script}"\r\n', encoding="utf-8")
+    prompt = "issue text with unicode: æ—¥æœ¬èªž and \U0001F680"
+
+    result, _stderr, _wall = runner.run_agent(tmp_path, prompt, "a", None, 1, {}, None, None,
+                                              {"path": str(wrapper)})
+
+    assert result == {"echo": prompt}
+
