+def test_run_agent_sends_prompt_as_utf8_regardless_of_host_locale(tmp_path, monkeypatch):
+    """A host on the legacy Windows cp1252 code page must still deliver the prompt's Unicode
+    text unchanged to the child process, not raise UnicodeEncodeError before it starts."""
+    captured = {}
+
+    def fake_run(cmd, **kw):
+        captured["cmd"] = cmd
+        captured.update(kw)
+        return subprocess.CompletedProcess(cmd, 0, stdout='{"result": "ok", "session_id": "s"}', stderr="")
+
+    monkeypatch.setattr(runner.subprocess, "run", fake_run)
+    prompt = "issue text with unicode: cafÃ©, rÃ©sumÃ©, ä¸­æ–‡, emoji ðŸŽ‰"
+    claude_cli = {"path": str(tmp_path / "claude"), "sha256": "x", "version": "1"}
+    result, stderr, wall = runner.run_agent(tmp_path, prompt, "a", None, 1, {}, None, None, claude_cli)
+    assert captured["input"] == prompt
+    assert captured["encoding"] == "utf-8"
+    assert result == {"result": "ok", "session_id": "s"}
+
