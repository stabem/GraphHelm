+def test_run_agent_encodes_prompt_as_utf8_not_locale_default(monkeypatch):
+    """Catches UnicodeEncodeError from subprocess.run encoding stdin with
+    locale.getpreferredencoding() (e.g. cp1252 on a legacy Windows host) instead of an
+    explicit UTF-8, which either crashes the runner or corrupts a non-ASCII prompt."""
+    prompt = "Non-ASCII text outside cp1252: æ—¥æœ¬èªž âœ… \U0001F600"
+    try:
+        prompt.encode("cp1252")
+    except UnicodeEncodeError:
+        pass
+    else:
+        raise AssertionError("test prompt must contain text outside cp1252's repertoire")
+
+    captured = {}
+
+    def fake_run(cmd, **kwargs):
+        captured.update(kwargs)
+        return subprocess.CompletedProcess(cmd, 0, stdout=runner.json.dumps({"session_id": "s"}), stderr="")
+
+    monkeypatch.setattr(runner.subprocess, "run", fake_run)
+    result, _stderr, _wall = runner.run_agent(Path("."), prompt, "a", None, 1, {}, None, None,
+                                              {"path": "claude"})
+    assert captured.get("encoding") == "utf-8"
+    assert captured.get("input") == prompt
+    assert result == {"session_id": "s"}
+
+
 def test_worktree_scratch_must_be_outside_repository(monkeypatch):
     """Catches generated checkouts being written into the source worktree tree."""
     monkeypatch.setenv("TOKEN_BENCH_SCRATCH", str(runner.REPO))
