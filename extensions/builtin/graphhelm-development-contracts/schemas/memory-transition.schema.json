{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/schemas/memory-transition.schema.json",
  "title": "Governed memory transition matrix",
  "description": "The states and transitions of a memory record, and the ALLOWED tuples. The allowed set is written out because it is policy; the matrix that exercises it is derived from these vocabularies, so a tuple nobody thought about is still visited. Every tuple not listed here refuses without changing its predecessor.",
  "type": "object",
  "required": ["policyVersion", "states", "transitions", "allowed"],
  "additionalProperties": false,
  "properties": {
    "policyVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "states": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/state"}
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/transition"}
    },
    "allowed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/allowedTuple"}
    }
  },
  "$defs": {
    "state": {
      "type": "string",
      "enum": ["provisional", "published", "superseded", "withdrawn"]
    },
    "transition": {
      "type": "string",
      "enum": ["publish", "supersede", "withdraw"]
    },
    "allowedTuple": {
      "type": "object",
      "required": ["from", "transition", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {"$ref": "#/$defs/state"},
        "transition": {"$ref": "#/$defs/transition"},
        "to": {"$ref": "#/$defs/state"}
      }
    }
  }
}
