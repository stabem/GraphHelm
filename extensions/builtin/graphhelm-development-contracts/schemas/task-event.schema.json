{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/schemas/task-event.schema.json",
  "title": "Task Event",
  "description": "One graphhelm-task-event-v1 document: the description of a task.* signal a lane records at each delivery step (journey-first spec section 7, #386). The signal type names the kind (task.claimed, task.planned, task.released, task.heartbeat, task.pr_opened, task.review_assigned, task.review_verdict, task.review_activity, task.merged, task.closed, task.critic_verdict, task.queued, and the owner's task.lane_retired); the identity fields (lane, reviewer, merger) must equal the actor that records it, which the Runtime enforces. The Studio folds the per-task graph from these records alone.",
  "oneOf": [
    {
      "title": "task.review_activity",
      "description": "A deliberate current-reviewer statement bound to its exact current head and review generation; never a lease renewal or verdict.",
      "type": "object",
      "required": [
        "schema",
        "taskId",
        "revision",
        "at",
        "repo",
        "pr",
        "headSha",
        "reviewer",
        "reviewContextSequence",
        "activity"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "graphhelm-task-event-v1"
        },
        "taskId": {
          "$ref": "#/$defs/taskId"
        },
        "revision": {
          "$ref": "#/$defs/positive"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "pr": {
          "$ref": "#/$defs/positive"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer": {
          "$ref": "#/$defs/actor"
        },
        "reviewContextSequence": {
          "$ref": "#/$defs/positive"
        },
        "activity": {
          "enum": [
            "waiting",
            "resumed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "activity": {
                "const": "waiting"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    },
    {
      "title": "task.claimed",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "issue", "lane", "branch"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "issue": {"$ref": "#/$defs/positive"},
        "lane": {"$ref": "#/$defs/actor"},
        "assignedBy": {"description": "Who ordered the work, as reported by the claiming lane; absent means unknown. The Runtime refuses a value equal to lane.", "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$"},
        "branch": {"type": "string", "minLength": 1, "maxLength": 256},
        "plan": {"type": "object"},
        "repo": {"$ref": "#/$defs/repo"},
        "title": {"$ref": "#/$defs/title"},
        "summary": {"$ref": "#/$defs/summary"},
        "parent": {"description": "The issue whose work turned this task up (#514); the Studio draws this task inside that issue's card.", "$ref": "#/$defs/positive"},
        "journeys": {"description": "The journey contract ids the issue serves (#577); the Studio Graph tab links the task to them from the claim on.", "type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/taskId"}},
        "leaseSeconds": {"description": "#1193: how long the claim stays live without a heartbeat, in seconds, never below the 300 s heartbeat cooldown (a shorter lease could not be kept alive). The tasks fold reads the claim as overdue once the later of the claim and its last heartbeat plus this lease has passed; absent means 1800.", "type": "integer", "minimum": 300, "maximum": 86400},
        "agentKind": {"description": "#1851: what kind of agent the claiming lane is (claude, codex), as it reports it; absent means unknown. The tasks view serves the newest per lane to owner credentials.", "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "agentModel": {"description": "#1851: the model the claiming lane runs on (opus, sonnet, fast), as it reports it; absent means unknown.", "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
      }
    },
    {
      "title": "task.released",
      "description": "#729: release only the actor's pre-PR claim, bound to its exact claim record sequence. #1193: the reconciler, signing as graphhelm with releasedBy, releases the named lane's overdue claim.",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "lane", "claimSequence", "reason"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "lane": {"$ref": "#/$defs/actor"},
        "claimSequence": {"$ref": "#/$defs/positive"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
        "releasedBy": {"description": "#1193: present only when the recording actor is graphhelm (the Stop reconciler) and lane names another actor whose claim lapsed; the Runtime refuses any other combination.", "const": "graphhelm"}
      }
    },
    {
      "title": "task.released by slice key",
      "description": "#1424: the owner (or the orchestrator, holding the owner token) releases one open slice by the key the tasks route serves, including a slice with no claim sequence. Recorded by an owner actor only; releasedBy is that actor and lane is the slice's lane.",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "lane", "sliceKey", "reason", "releasedBy"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "lane": {"$ref": "#/$defs/actor"},
        "sliceKey": {"type": "string", "minLength": 1, "maxLength": 256},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
        "releasedBy": {"$ref": "#/$defs/actor"}
      }
    },
    {
      "title": "task.lane_retired",
      "description": "#1424: the owner (or the orchestrator) retires the named lanes (retired: true): from this record on their open slices read orphaned and released, they leave liveness, and the Runtime refuses their records. retired: false restores them. Recorded by an owner actor only.",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "lanes", "retired", "reason"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "lanes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/actor"}},
        "retired": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}
      }
    },
    {
      "title": "task.heartbeat",
      "description": "Activity from a claiming lane with an open pre-PR claim; admission enforces the 300-second cooldown using trusted event time. #1556: an optional reason says what the lane is waiting on, shown on its card.",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "lane"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "lane": {"$ref": "#/$defs/actor"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}
      }
    },
    {
      "title": "task.planned",
      "description": "#480: the lane's keel plan for the task, recorded right after task.claimed; the Studio lights the Plan step from it, and a Critic step when critic.mode is design (#467).",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "lane", "classes", "reviews", "proof", "critic", "summary"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "lane": {"$ref": "#/$defs/actor"},
        "classes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["docs", "code", "user_visible", "invariant"]}},
        "reviews": {"type": "integer", "minimum": 1, "maximum": 5},
        "proof": {"enum": ["none", "tests", "journey", "both"]},
        "critic": {
          "type": "object",
          "required": ["mode", "passScore", "maxRounds"],
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["none", "design"]},
            "passScore": {"type": "integer", "minimum": 1, "maximum": 10},
            "maxRounds": {"type": "integer", "minimum": 1, "maximum": 5}
          }
        },
        "summary": {"$ref": "#/$defs/summary"}
      }
    },
    {
      "title": "task.pr_opened",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "pr", "headSha", "journeys", "lane"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "pr": {"$ref": "#/$defs/positive"},
        "headSha": {"$ref": "#/$defs/sha"},
        "journeys": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/taskId"}},
        "lane": {"$ref": "#/$defs/actor"},
        "repo": {"$ref": "#/$defs/repo"},
        "title": {"$ref": "#/$defs/title"},
        "summary": {"$ref": "#/$defs/summary"}
      }
    },
    {
      "title": "task.review_assigned",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "pr", "headSha", "reviewer", "ordinal"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "pr": {"$ref": "#/$defs/positive"},
        "headSha": {"$ref": "#/$defs/sha"},
        "reviewer": {"$ref": "#/$defs/actor"},
        "ordinal": {"enum": [1, 2]}
      }
    },
    {
      "title": "task.review_verdict",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "pr", "headSha", "reviewer", "verdict", "commentUrl"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "pr": {"$ref": "#/$defs/positive"},
        "headSha": {"$ref": "#/$defs/sha"},
        "reviewer": {"$ref": "#/$defs/actor"},
        "verdict": {"enum": ["APPROVE", "APPROVE-WITH-RISK", "BLOCK"]},
        "commentUrl": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    {
      "title": "task.merged",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "pr", "mergeSha", "closes", "merger"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "pr": {"$ref": "#/$defs/positive"},
        "mergeSha": {"$ref": "#/$defs/sha"},
        "closes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/positive"}},
        "merger": {"$ref": "#/$defs/actor"}
      }
    },
    {
      "title": "task.closed",
      "description": "The PR was closed without merging; the reason distinguishes replacement from abandonment, and by names the superseding issue or PR.",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "pr", "reason", "by"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "pr": {"$ref": "#/$defs/positive"},
        "reason": {"enum": ["superseded", "abandoned"]},
        "by": {"$ref": "#/$defs/positive"},
        "observed": {"const": true, "description": "#1544: the recording lane saw the PR closed on GitHub (the Stop reconciler); it did not close it. Absent means the recording lane closed it."}
      }
    },
    {
      "title": "task.critic_verdict",
      "description": "#467: one round of the blind design critic, recorded by the lane. The Runtime also refuses a verdict that disagrees with its score and round: pass needs score >= passScore; revise needs score < passScore and round < maxRounds; exhausted needs score < passScore and round == maxRounds. Running out of rounds is never a pass.",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "round", "score", "passScore", "maxRounds", "verdict", "designRef", "lane", "reasons"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "round": {"type": "integer", "minimum": 1, "maximum": 5},
        "score": {"type": "integer", "minimum": 0, "maximum": 10},
        "passScore": {"type": "integer", "minimum": 1, "maximum": 10},
        "maxRounds": {"type": "integer", "minimum": 1, "maximum": 5},
        "verdict": {"enum": ["pass", "revise", "exhausted"]},
        "designRef": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\u0000-\u001f\u007f]+$"},
        "lane": {"$ref": "#/$defs/actor"},
        "reasons": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\u0000-\u001f\u007f]+$"}}
      }
    },
    {
      "title": "task.queued",
      "description": "#1469: the open wave issues its recorder read from the issue tracker, at most 25 so the record stays under the 8 KiB description limit. It opens no slice: the newest task.queued replaces the earlier ones, and the tasks route serves its issues that no live slice holds as the Lanes Backlog, oldest first.",
      "type": "object",
      "required": ["schema", "taskId", "revision", "at", "issues"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "graphhelm-task-event-v1"},
        "taskId": {"$ref": "#/$defs/taskId"},
        "revision": {"$ref": "#/$defs/positive"},
        "at": {"$ref": "#/$defs/at"},
        "repo": {"$ref": "#/$defs/repo"},
        "issues": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "required": ["issue", "title", "openedAt"],
            "additionalProperties": false,
            "properties": {
              "issue": {"$ref": "#/$defs/positive"},
              "title": {"$ref": "#/$defs/title"},
              "openedAt": {"$ref": "#/$defs/at"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 128},
    "positive": {"type": "integer", "minimum": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "at": {"type": "string", "minLength": 1, "maxLength": 64},
    "title": {"description": "The issue's (on task.claimed) or the PR's (on task.pr_opened) title, as the owner reads it on the Team tab (#477). The delivery standard asks for 50 (issue) or 60 (PR) characters; up to 200 are accepted.", "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\u0000-\u001f\u007f]+$"},
    "summary": {"description": "One plain sentence saying who gets what (the body's Summary: line, #477). The standard asks for 100 characters; up to 300 are accepted.", "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\u0000-\u001f\u007f]+$"},
    "repo": {"description": "owner/name of the GitHub repository the task's issue and PR live in (#420); the Studio links them from it.", "type": "string", "maxLength": 140, "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/(\\.\\.?[A-Za-z0-9_-][A-Za-z0-9_.-]{0,97}|[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99})$"}
  }
}
