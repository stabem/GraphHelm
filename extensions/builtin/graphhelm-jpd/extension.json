{
  "apiVersion": "p50.dev/v1",
  "kind": "Extension",
  "metadata": {
    "id": "graphhelm-jpd",
    "version": "0.1.0",
    "publisher": "GraphHelm",
    "source": {
      "repository": "https://github.com/stabem/GraphHelm"
    }
  },
  "spec": {
    "type": "skill-package",
    "capabilities": [
      "skill.defect-bounty",
      "skill.journey-contract",
      "skill.journey-verifier",
      "skill.observation-compiler",
      "skill.plan-council",
      "skill.retry-provenance",
      "skill.skill-evaluator",
      "skill.skill-synthesizer"
    ],
    "permissions": {
      "filesystem": {
        "package": "read",
        "workspaceArtifacts": "proposal-write"
      },
      "network": {
        "external": false,
        "loopbackRuntimeApi": true
      },
      "runtime": {
        "read": true,
        "mutations": [
          "amend_budget",
          "approve",
          "cancel",
          "pause",
          "quality_certify",
          "resume",
          "signal",
          "start",
          "wake_arm"
        ],
        "ownerConfirmationRequired": [
          "amend_budget",
          "approve",
          "cancel",
          "pause_immediate"
        ]
      },
      "secrets": {
        "artifactValues": false,
        "tokenFile": "reference-only"
      }
    },
    "contracts": {
      "formatVersion": "1.0.0",
      "activation": "explicit",
      "composition": "adaptive",
      "publication": "governor-only",
      "entryFamilies": [
        "defect-bounty",
        "journey-contract",
        "journey-verifier",
        "observation-compiler",
        "plan-council",
        "retry-provenance",
        "skill-evaluator",
        "skill-synthesizer"
      ],
      "artifactFlowFormat": "p50.dev/jpd/artifact-flow/v1",
      "artifactFlows": [
        {
          "family": "journey-contract",
          "inputs": [
            "task:scope",
            "runtime:events",
            "runtime:status"
          ],
          "outputs": [
            "schema:journey-contract"
          ]
        },
        {
          "family": "observation-compiler",
          "inputs": [
            "schema:journey-contract",
            "evaluator:evidence-strength-lattice",
            "observer:catalog",
            "runtime:events",
            "runtime:status",
            "schema:observer-capability"
          ],
          "outputs": [
            "schema:observation-obligation"
          ]
        },
        {
          "family": "plan-council",
          "inputs": [
            "schema:journey-contract",
            "schema:observation-obligation",
            "policy:assurance-tier-policy",
            "policy:council-selection-policy",
            "runtime:events",
            "runtime:status"
          ],
          "outputs": [
            "schema:council-result"
          ]
        },
        {
          "family": "defect-bounty",
          "inputs": [
            "schema:journey-contract",
            "schema:observation-obligation",
            "runtime:events",
            "runtime:status"
          ],
          "outputs": [
            "schema:journey-defect-claim"
          ]
        },
        {
          "family": "skill-synthesizer",
          "inputs": [
            "artifact:installed-capability-catalog",
            "observer:catalog",
            "policy:skill-promotion-policy",
            "runtime:events",
            "runtime:status",
            "schema:journey-contract",
            "schema:journey-verification-result",
            "schema:observation-obligation"
          ],
          "outputs": [
            "schema:skill-capsule"
          ]
        },
        {
          "family": "skill-evaluator",
          "inputs": [
            "policy:skill-promotion-policy",
            "runtime:events",
            "runtime:status",
            "schema:skill-capsule",
            "schema:journey-verification-result",
            "schema:journey-defect-claim"
          ],
          "outputs": [
            "schema:skill-evaluation"
          ]
        },
        {
          "family": "retry-provenance",
          "inputs": [
            "evaluator:retry-classification-policy",
            "evaluator:retry-lineage-validation-policy",
            "runtime:events",
            "runtime:status",
            "schema:retry-lineage-input"
          ],
          "outputs": [
            "schema:retry-chain-input",
            "schema:retry-chain"
          ]
        },
        {
          "family": "journey-verifier",
          "inputs": [
            "observer:catalog",
            "policy:assurance-tier-policy",
            "runtime:events",
            "runtime:status",
            "schema:council-result",
            "schema:journey-contract",
            "schema:observation-obligation",
            "schema:observer-capability",
            "schema:retry-chain"
          ],
          "outputs": [
            "schema:journey-verification-result"
          ]
        }
      ],
      "missingCapabilityResult": "unresolved",
      "hostViews": ["derived-and-deletable"],
