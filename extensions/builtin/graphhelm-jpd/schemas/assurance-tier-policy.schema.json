{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/assurance-tier-policy.schema.json",
  "title": "GraphHelm JPD Assurance Tier Policy Contract",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "p50.dev/jpd/v1" },
    "kind": { "const": "AssuranceTierPolicyContract" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "graphhelm-jpd/assurance-tier" },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "runtimeStatus",
        "requiresRegisteredEvaluator",
        "evaluationSemantics",
        "inputSchema",
        "outputField",
        "evaluationOrder",
        "rules",
        "tierRequirements",
        "invariants"
      ],
      "properties": {
        "runtimeStatus": { "const": "declarative_only" },
        "requiresRegisteredEvaluator": { "const": true },
        "evaluationSemantics": { "const": "deterministic_when_registered" },
        "inputSchema": {
          "const": "https://p50.dev/extensions/graphhelm-jpd/schemas/journey-contract.schema.json"
        },
        "outputField": { "const": "assuranceTier" },
        "evaluationOrder": { "const": "first_match" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/riskRule" },
              { "$ref": "#/$defs/defaultRule" }
            ]
          }
        },
        "tierRequirements": { "$ref": "#/$defs/tierRequirements" },
        "invariants": { "$ref": "#/$defs/invariants" }
      },
      "additionalProperties": false
    },
    "riskSignal": {
      "enum": [
        "accessibility",
        "ambiguous_behavior",
        "authentication",
        "concurrency",
        "critical_ux",
        "external_delivery",
        "irreversible_effect",
        "money",
        "multiple_components",
        "personal_data",
        "production_impact",
        "recovery",
        "security"
      ]
    },
    "tier": {
      "enum": ["direct", "deliberative", "adversarial"]
    },
    "ruleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "riskRule": {
      "type": "object",
      "required": ["id", "matchAnyRiskSignal", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "matchAnyRiskSignal": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/riskSignal" }
        },
        "result": { "$ref": "#/$defs/tier" }
      },
      "additionalProperties": false
    },
    "defaultRule": {
      "type": "object",
      "required": ["id", "match", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "match": { "const": "always" },
        "result": { "$ref": "#/$defs/tier" }
      },
      "additionalProperties": false
    },
    "tierRequirements": {
      "type": "object",
      "required": ["direct", "deliberative", "adversarial"],
      "properties": {
        "direct": { "$ref": "#/$defs/tierRequirement" },
        "deliberative": { "$ref": "#/$defs/tierRequirement" },
        "adversarial": { "$ref": "#/$defs/tierRequirement" }
      },
      "additionalProperties": false
    },
    "tierRequirement": {
      "type": "object",
      "required": [
        "independentCriticRequired",
        "counterexampleSearchRequired",
        "recoveryProofRequired",
        "minimumAdequateObservers"
      ],
      "properties": {
        "independentCriticRequired": { "type": "boolean" },
        "counterexampleSearchRequired": { "type": "boolean" },
        "recoveryProofRequired": { "type": "boolean" },
        "minimumAdequateObservers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "additionalProperties": false
}
