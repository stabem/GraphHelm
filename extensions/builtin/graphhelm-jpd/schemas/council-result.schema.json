{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/council-result.schema.json",
  "title": "GraphHelm JPD Council Result Candidate",
  "type": "object",
  "required": [
    "resultId",
    "councilRunId",
    "journeyRunId",
    "contractId",
    "createdAt",
    "status",
    "authority",
    "selection",
    "participants",
    "lineage",
    "claims",
    "dissent",
    "decision"
  ],
  "properties": {
    "resultId": {
      "$ref": "#/$defs/id"
    },
    "councilRunId": {
      "$ref": "#/$defs/id"
    },
    "journeyRunId": {
      "$ref": "#/$defs/id"
    },
    "contractId": {
      "$ref": "#/$defs/id"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "status": {
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "authority": {
      "$ref": "#/$defs/candidateAuthority"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "participants": {
      "$ref": "#/$defs/participantInventory"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "claims": {
      "$ref": "#/$defs/claimInventory"
    },
    "dissent": {
      "$ref": "#/$defs/dissentInventory"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dissent": {
            "properties": {
              "items": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "unresolved"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "required": [
              "items"
            ]
          }
        },
        "required": [
          "dissent"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "status": {
                "enum": [
                  "recommended_with_dissent",
                  "blocked"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claims": {
            "properties": {
              "items": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "unresolved"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "required": [
              "items"
            ]
          }
        },
        "required": [
          "claims"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "status": {
                "enum": [
                  "recommended_with_dissent",
                  "blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "opaqueReferenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]{1,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rawSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "role": {
      "enum": [
        "defect-hunter",
        "idea-generator",
        "adversarial-critic",
        "evidence-advocate",
        "accessibility-user",
        "recovery-operator",
        "disagreement-resolver"
      ]
    },
    "artifactDigestBinding": {
      "type": "object",
      "required": [
        "referenceId",
        "contentDigest"
      ],
      "properties": {
        "referenceId": {
          "$ref": "#/$defs/opaqueReferenceId"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "evidenceReference": {
      "type": "object",
      "required": [
        "evidenceId",
        "contentSha256",
        "ciphertextSha256"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/opaqueReferenceId"
        },
        "contentSha256": {
          "$ref": "#/$defs/rawSha256"
        },
        "ciphertextSha256": {
          "$ref": "#/$defs/rawSha256"
        }
      },
      "additionalProperties": false
    },
    "candidateAuthority": {
      "type": "object",
      "required": [
        "status",
        "validation",
        "mayDecideGate",
        "mayPublishGraph"
      ],
      "properties": {
        "status": {
          "const": "candidate"
        },
        "validation": {
          "type": "object",
          "required": [
            "status",
            "code",
            "missingCapability",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "capability_missing"
            },
            "code": {
              "const": "COUNCIL_RESULT_VALIDATOR_MISSING"
            },
            "missingCapability": {
              "const": "jpd.registered-deterministic-council-validator"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          },
          "additionalProperties": false
        },
        "mayDecideGate": {
          "const": false
        },
        "mayPublishGraph": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "status",
        "assuranceTier",
        "policyRef",
        "inputDigest",
        "selectedRoles",
        "evaluation"
      ],
      "properties": {
        "status": {
          "const": "advisory"
        },
        "assuranceTier": {
          "enum": [
            "deliberative",
            "adversarial"
          ]
        },
        "policyRef": {
          "$ref": "#/$defs/artifactDigestBinding"
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "selectedRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "evaluation": {
          "type": "object",
          "required": [
            "status",
            "code",
            "missingCapability",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "capability_missing"
            },
            "code": {
              "const": "COUNCIL_SELECTION_EVALUATOR_MISSING"
            },
            "missingCapability": {
              "const": "jpd.registered-deterministic-council-selector"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "participantInventory": {
      "type": "object",
      "required": [
        "completeness",
        "participantCount",
        "inventoryDigest",
        "items"
      ],
      "properties": {
        "completeness": {
          "const": "complete"
        },
        "participantCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "inventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/participant"
          }
        }
      },
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "required": [
        "identity",
        "run"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/participantIdentity"
        },
        "run": {
          "$ref": "#/$defs/participantRun"
        }
      },
      "additionalProperties": false
    },
    "participantIdentity": {
      "type": "object",
      "required": [
        "participantId",
        "role",
        "agentDefinitionRef"
      ],
      "properties": {
        "participantId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "agentDefinitionRef": {
          "$ref": "#/$defs/artifactDigestBinding"
        }
      },
      "additionalProperties": false
    },
    "participantRun": {
      "type": "object",
      "required": [
        "runId",
        "status",
        "authority",
        "model",
        "promptDigest",
        "contextCapsuleDigest",
        "capabilitySetDigest",
        "inputDigest",
        "outputRef"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "authority": {
          "$ref": "#/$defs/runAuthority"
        },
        "model": {
          "$ref": "#/$defs/modelIdentity"
        },
        "promptDigest": {
          "$ref": "#/$defs/digest"
        },
        "contextCapsuleDigest": {
          "$ref": "#/$defs/digest"
        },
        "capabilitySetDigest": {
          "$ref": "#/$defs/digest"
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "outputRef": {
          "$ref": "#/$defs/artifactDigestBinding"
        }
      },
      "additionalProperties": false
    },
    "runAuthority": {
      "type": "object",
      "required": [
        "kind",
        "grantRef",
        "taskScopeDigest",
        "mayDecideGate",
        "mayPublishGraph"
      ],
      "properties": {
        "kind": {
          "const": "task_local_advisory"
        },
        "grantRef": {
          "$ref": "#/$defs/artifactDigestBinding"
        },
        "taskScopeDigest": {
          "$ref": "#/$defs/digest"
        },
        "mayDecideGate": {
          "const": false
        },
        "mayPublishGraph": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "modelIdentity": {
      "type": "object",
      "required": [
        "provider",
        "modelId",
        "modelVersion"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/shortText"
        },
        "modelId": {
          "$ref": "#/$defs/shortText"
        },
        "modelVersion": {
          "$ref": "#/$defs/shortText"
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": [
        "contractDigest",
        "selectionInputDigest",
        "participantInventoryDigest",
        "normalizationInputDigest",
        "decisionInputDigest",
        "canonicalization",
        "digestAlgorithm"
      ],
      "properties": {
        "contractDigest": {
          "$ref": "#/$defs/digest"
        },
        "selectionInputDigest": {
          "$ref": "#/$defs/digest"
        },
        "participantInventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "normalizationInputDigest": {
          "$ref": "#/$defs/digest"
        },
        "decisionInputDigest": {
          "$ref": "#/$defs/digest"
        },
        "predecessorResultRef": {
          "$ref": "#/$defs/artifactDigestBinding"
        },
        "canonicalization": {
          "const": "rfc8785-json"
        },
        "digestAlgorithm": {
          "const": "sha256"
        }
      },
      "additionalProperties": false
    },
    "claimInventory": {
      "type": "object",
      "required": [
        "completeness",
        "itemCount",
        "inventoryDigest",
        "sourceParticipantInventoryDigest",
        "items"
      ],
      "properties": {
        "completeness": {
          "type": "object",
          "required": [
            "status",
            "includesEveryParticipantOutput",
            "preservesRejectedAndFalsified"
          ],
          "properties": {
            "status": {
              "const": "complete"
            },
            "includesEveryParticipantOutput": {
              "const": true
            },
            "preservesRejectedAndFalsified": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "inventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceParticipantInventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "items": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "claimId",
        "kind",
        "originParticipantId",
        "sourceRef",
        "normalizedClaimDigest",
        "status",
        "severity",
        "statementDigest",
        "evidenceRefs"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "option",
            "assumption",
            "defect",
            "support",
            "objection",
            "counterexample"
          ]
        },
        "originParticipantId": {
          "$ref": "#/$defs/id"
        },
        "sourceRef": {
          "$ref": "#/$defs/artifactDigestBinding"
        },
        "normalizedClaimDigest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "falsified",
            "unresolved"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "statementDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      },
      "additionalProperties": false
    },
    "dissentInventory": {
      "type": "object",
      "required": [
        "completeness",
        "itemCount",
        "inventoryDigest",
        "sourceClaimInventoryDigest",
        "items"
      ],
      "properties": {
        "completeness": {
          "type": "object",
          "required": [
            "status",
            "includesResolved",
            "includesUnresolved"
          ],
          "properties": {
            "status": {
              "const": "complete"
            },
            "includesResolved": {
              "const": true
            },
            "includesUnresolved": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "inventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceClaimInventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "items": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dissent"
          }
        }
      },
      "additionalProperties": false
    },
    "dissent": {
      "type": "object",
      "required": [
        "dissentId",
        "kind",
        "participantIds",
        "claimIds",
        "statementDigest",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "dissentId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "claim_conflict",
            "evidence_gap",
            "residual_risk"
          ]
        },
        "participantIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "claimIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "statementDigest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved",
            "accepted_as_risk"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "discriminatingObservation": {
          "$ref": "#/$defs/text"
        },
        "resolutionRef": {
          "$ref": "#/$defs/artifactDigestBinding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "resolutionRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "discriminatingObservation"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "status",
        "authority",
        "mayDecideGate",
        "claimInventoryDigest",
        "dissentInventoryDigest",
        "decisionInputDigest",
        "selectedClaimIds",
        "rejectedClaimIds",
        "unresolvedDissentIds",
        "rationaleDigest",
        "evidenceRefs"
      ],
      "properties": {
        "status": {
          "enum": [
            "recommended",
            "recommended_with_dissent",
            "blocked"
          ]
        },
        "authority": {
          "const": "advisory_only"
        },
        "mayDecideGate": {
          "const": false
        },
        "claimInventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "dissentInventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "decisionInputDigest": {
          "$ref": "#/$defs/digest"
        },
        "selectedClaimIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "rejectedClaimIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "unresolvedDissentIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "rationaleDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
