{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/evidence-strength-lattice.schema.json",
  "title": "GraphHelm JPD Evidence Strength Lattice Contract",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "p50.dev/jpd/v1"
    },
    "kind": {
      "const": "EvidenceStrengthLatticeContract"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "graphhelm-jpd/evidence-strength-lattice"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "runtimeStatus",
        "requiresRegisteredEvaluator",
        "evaluationSemantics",
        "principle",
        "trustCompatibility",
        "evidenceKinds",
        "facts",
        "dominates",
        "explicitlyIncomparable",
        "refusal"
      ],
      "properties": {
        "runtimeStatus": {
          "const": "declarative_only"
        },
        "requiresRegisteredEvaluator": {
          "const": true
        },
        "evaluationSemantics": {
          "const": "deterministic_when_registered"
        },
        "principle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "trustCompatibility": {
          "$ref": "#/$defs/trustCompatibility"
        },
        "evidenceKinds": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/symbol"
          },
          "additionalProperties": {
            "$ref": "#/$defs/evidenceKind"
          }
        },
        "facts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/symbol"
          },
          "additionalProperties": {
            "$ref": "#/$defs/factRule"
          }
        },
        "dominates": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dominanceRule"
          }
        },
        "explicitlyIncomparable": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/incomparabilityRule"
          }
        },
        "refusal": {
          "type": "object",
          "required": [
            "code",
            "when",
            "preserveRejectedProxies",
            "allowProxyUpgrade"
          ],
          "properties": {
            "code": {
              "const": "OBSERVER_MISSING"
            },
            "when": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "preserveRejectedProxies": {
              "const": true
            },
            "allowProxyUpgrade": {
              "const": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "symbolList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "trust": {
      "enum": [
        "first_party_deterministic",
        "first_party_instrumented",
        "third_party_receipt",
        "visual_capture",
        "operator_attestation"
      ]
    },
    "trustList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trust"
      }
    },
    "trustFactCompatibility": {
      "type": "object",
      "required": [
        "satisfiesMinimum"
      ],
      "properties": {
        "satisfiesMinimum": {
          "type": "object",
          "required": [
            "first_party_deterministic",
            "first_party_instrumented",
            "third_party_receipt",
            "visual_capture",
            "operator_attestation"
          ],
          "properties": {
            "first_party_deterministic": {
              "$ref": "#/$defs/trustList"
            },
            "first_party_instrumented": {
              "$ref": "#/$defs/trustList"
            },
            "third_party_receipt": {
              "$ref": "#/$defs/trustList"
            },
            "visual_capture": {
              "$ref": "#/$defs/trustList"
            },
            "operator_attestation": {
              "$ref": "#/$defs/trustList"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trustCompatibility": {
      "type": "object",
      "required": [
        "relationId",
        "relationVersion",
        "semantics",
        "defaultDecision",
        "levels",
        "facts"
      ],
      "properties": {
        "relationId": {
          "const": "graphhelm-jpd/trust-compatibility"
        },
        "relationVersion": {
          "const": "1.0.0"
        },
        "semantics": {
          "const": "explicit_fact_scoped_partial_order"
        },
        "defaultDecision": {
          "const": "incompatible"
        },
        "levels": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "first_party_deterministic"
            },
            {
              "const": "first_party_instrumented"
            },
            {
              "const": "third_party_receipt"
            },
            {
              "const": "visual_capture"
            },
            {
              "const": "operator_attestation"
            }
          ],
          "items": false
        },
        "facts": {
          "type": "object",
          "required": [
            "command_completed",
            "request_accepted",
            "state_persisted",
            "message_delivered",
            "content_rendered",
            "control_operable",
            "recovery_safe",
            "event_history_intact"
          ],
          "properties": {
            "command_completed": {
              "$ref": "#/$defs/trustFactCompatibility"
            },
            "request_accepted": {
              "$ref": "#/$defs/trustFactCompatibility"
            },
            "state_persisted": {
              "$ref": "#/$defs/trustFactCompatibility"
            },
            "message_delivered": {
              "$ref": "#/$defs/trustFactCompatibility"
            },
            "content_rendered": {
              "$ref": "#/$defs/trustFactCompatibility"
            },
            "control_operable": {
              "$ref": "#/$defs/trustFactCompatibility"
            },
            "recovery_safe": {
              "$ref": "#/$defs/trustFactCompatibility"
            },
            "event_history_intact": {
              "$ref": "#/$defs/trustFactCompatibility"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidenceKind": {
      "type": "object",
      "required": [
        "description",
        "freshnessClass"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "freshnessClass": {
          "enum": [
            "immutable_by_input",
            "snapshot_closed",
            "drifting"
          ]
        }
      },
      "additionalProperties": false
    },
    "factRule": {
      "type": "object",
      "required": [
        "adequate"
      ],
      "properties": {
        "adequate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "rejectedProxies": {
          "$ref": "#/$defs/symbolList"
        },
        "supportingOnly": {
          "$ref": "#/$defs/symbolList"
        },
        "combinationRequired": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "combinationRequired": {
                "const": true
              }
            },
            "required": [
              "combinationRequired"
            ]
          },
          "then": {
            "properties": {
              "adequate": {
                "minItems": 2
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "dominanceRule": {
      "type": "object",
      "required": [
        "stronger",
        "weaker",
        "onlyForFacts"
      ],
      "properties": {
        "stronger": {
          "$ref": "#/$defs/symbol"
        },
        "weaker": {
          "$ref": "#/$defs/symbol"
        },
        "onlyForFacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        }
      },
      "additionalProperties": false
    },
    "incomparabilityRule": {
      "type": "object",
      "required": [
        "left",
        "right",
        "reason"
      ],
      "properties": {
        "left": {
          "$ref": "#/$defs/symbol"
        },
        "right": {
          "$ref": "#/$defs/symbol"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
