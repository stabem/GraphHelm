{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/journey-contract.schema.json",
  "title": "GraphHelm JPD Journey Contract",
  "type": "object",
  "required": [
    "contractId",
    "version",
    "title",
    "taskScope",
    "actors",
    "preconditions",
    "steps",
    "promises",
    "riskSignals",
    "outOfScope"
  ],
  "properties": {
    "contractId": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "taskScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "preconditions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/boundedText"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "promises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/promise"
      }
    },
    "riskSignals": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "enum": [
          "accessibility",
          "ambiguous_behavior",
          "authentication",
          "concurrency",
          "critical_ux",
          "external_delivery",
          "irreversible_effect",
          "money",
          "multiple_components",
          "personal_data",
          "production_impact",
          "recovery",
          "security"
        ]
      }
    },
    "outOfScope": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/boundedText"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "actor": {
      "type": "object",
      "required": [
        "actorId",
        "name",
        "goal"
      ],
      "properties": {
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "goal": {
          "$ref": "#/$defs/boundedText"
        },
        "accessNeeds": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "strategy",
        "value"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "accessible_role",
            "label",
            "accessible_name",
            "visible_text",
            "stable_product_id",
            "coordinate"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "coordinates": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "additionalProperties": false
        },
        "geometryClaim": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "coordinate"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "required": [
              "coordinates",
              "geometryClaim"
            ],
            "properties": {
              "geometryClaim": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "geometryClaim": {
                "const": false
              }
            },
            "not": {
              "required": [
                "coordinates"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "semanticAction": {
      "type": "object",
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "enum": [
            "navigate",
            "activate",
            "enter_text",
            "select",
            "upload",
            "download",
            "wait_for",
            "inspect",
            "submit",
            "recover",
            "approve"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "input": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "failureContract": {
      "type": "object",
      "required": [
        "timeoutSeconds",
        "visibleError",
        "safeStop",
        "recoveryAction",
        "prohibitedSideEffects"
      ],
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "visibleError": {
          "$ref": "#/$defs/boundedText"
        },
        "safeStop": {
          "$ref": "#/$defs/boundedText"
        },
        "recoveryAction": {
          "anyOf": [
            {
              "$ref": "#/$defs/semanticAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "prohibitedSideEffects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/boundedText"
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "stepId",
        "actorId",
        "semanticAction",
        "expectedStates",
        "failureContract"
      ],
      "properties": {
        "stepId": {
          "$ref": "#/$defs/id"
        },
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "semanticAction": {
          "$ref": "#/$defs/semanticAction"
        },
        "expectedStates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "loading",
              "disabled",
              "empty",
              "error",
              "retrying",
              "success",
              "partial_success",
              "recovered",
              "stable"
            ]
          }
        },
        "failureContract": {
          "$ref": "#/$defs/failureContract"
        }
      },
      "additionalProperties": false
    },
    "promise": {
      "type": "object",
      "required": [
        "promiseId",
        "stepId",
        "statement",
        "requiredFact",
        "requiredEvidenceKinds",
        "requiredObserverCapability",
        "statesToObserve",
        "maxEvidenceAgeSeconds"
      ],
      "properties": {
        "promiseId": {
          "$ref": "#/$defs/id"
        },
        "stepId": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/boundedText"
        },
        "requiredFact": {
          "enum": [
            "command_completed",
            "request_accepted",
            "state_persisted",
            "message_delivered",
            "content_rendered",
            "control_operable",
            "recovery_safe",
            "event_history_intact"
          ]
        },
        "requiredEvidenceKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceKind"
          }
        },
        "requiredObserverCapability": {
          "$ref": "#/$defs/id"
        },
        "statesToObserve": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "loading",
              "disabled",
              "empty",
              "error",
              "retrying",
              "success",
              "partial_success",
              "recovered",
              "stable"
            ]
          }
        },
        "maxEvidenceAgeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        }
      },
      "additionalProperties": false
    },
    "evidenceKind": {
      "enum": [
        "process_exit",
        "http_acceptance",
        "queue_receipt",
        "durable_readback",
        "provider_delivery_receipt",
        "dom_semantic_snapshot",
        "accessibility_tree",
        "visual_capture",
        "interaction_trace",
        "event_chain_verification",
        "operator_attestation"
      ]
    }
  },
  "additionalProperties": false
}
