{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/observer-catalog.schema.json",
  "title": "GraphHelm JPD Observer Catalog",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "p50.dev/jpd/v1"
    },
    "kind": {
      "const": "ObserverCatalog"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "graphhelm-jpd/observer-catalog"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "runtimeStatus",
        "requiresRegisteredEvaluator",
        "evaluationSemantics",
        "selectionRequiresFreshCapabilityReceipt",
        "observerSchema",
        "observers"
      ],
      "properties": {
        "runtimeStatus": {
          "const": "declarative_only"
        },
        "requiresRegisteredEvaluator": {
          "const": true
        },
        "evaluationSemantics": {
          "const": "deterministic_when_registered"
        },
        "selectionRequiresFreshCapabilityReceipt": {
          "const": true
        },
        "observerSchema": {
          "const": "https://p50.dev/extensions/graphhelm-jpd/schemas/observer-capability.schema.json"
        },
        "observers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "https://p50.dev/extensions/graphhelm-jpd/schemas/observer-capability.schema.json"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
