{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/retry-chain.schema.json",
  "title": "GraphHelm JPD Classified Retry Chain",
  "type": "object",
  "required": [
    "journeyRunId",
    "rootAttemptId",
    "rootAttempt",
    "retries",
    "lineageComplete",
    "firstFailure",
    "successfulAttemptId",
    "lineageValidation",
    "outcomeClass",
    "classification",
    "classificationBasis"
  ],
  "properties": {
    "journeyRunId": {
      "$ref": "#/$defs/id"
    },
    "rootAttemptId": {
      "$ref": "#/$defs/id"
    },
    "rootAttempt": {
      "$ref": "#/$defs/rootAttempt"
    },
    "retries": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/retryAttempt"
      }
    },
    "lineageComplete": {
      "const": true
    },
    "firstFailure": {
      "anyOf": [
        {
          "$ref": "#/$defs/preservedFailure"
        },
        {
          "type": "null"
        }
      ]
    },
    "successfulAttemptId": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "lineageValidation": {
      "$ref": "#/$defs/lineageValidation"
    },
    "outcomeClass": {
      "oneOf": [
        {
          "$ref": "#/$defs/outcomeClass"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "classificationBasis": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "root_succeeded_without_retry",
          "later_attempt_succeeded",
          "material_evidence_delta",
          "explained_cause",
          "unexplained_cause",
          "no_attempt_succeeded",
          "first_failure_preserved"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rootAttempt": {
            "properties": {
              "result": {
                "const": "failed"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        "required": [
          "rootAttempt"
        ]
      },
      "then": {
        "properties": {
          "firstFailure": {
            "$ref": "#/$defs/preservedFailure"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rootAttempt": {
            "properties": {
              "result": {
                "const": "succeeded"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        "required": [
          "rootAttempt"
        ]
      },
      "then": {
        "properties": {
          "firstFailure": {
            "type": "null"
          },
          "retries": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "status": {
                "const": "capability_missing"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "outcomeClass": {
            "type": "null"
          },
          "classificationBasis": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "status": {
                "const": "evaluated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "outcomeClass": {
            "$ref": "#/$defs/outcomeClass"
          },
          "classificationBasis": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcomeClass": {
            "const": "first_pass_success"
          }
        },
        "required": [
          "outcomeClass"
        ]
      },
      "then": {
        "properties": {
          "rootAttempt": {
            "properties": {
              "result": {
                "const": "succeeded"
              }
            }
          },
          "retries": {
            "maxItems": 0
          },
          "firstFailure": {
            "type": "null"
          },
          "successfulAttemptId": {
            "$ref": "#/$defs/id"
          },
          "classificationBasis": {
            "$ref": "#/$defs/firstPassBasis"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcomeClass": {
            "const": "recovered_success"
          }
        },
        "required": [
          "outcomeClass"
        ]
      },
      "then": {
        "properties": {
          "rootAttempt": {
            "properties": {
              "result": {
                "const": "failed"
              }
            }
          },
          "retries": {
            "minItems": 1,
            "allOf": [
              {
                "$ref": "#/$defs/terminalSuccessfulRetries"
              }
            ],
            "contains": {
              "type": "object",
              "properties": {
                "causeTag": {
                  "enum": [
                    "product_fix",
                    "environment_recovery",
                    "test_repair",
                    "dependency_recovery"
                  ]
                },
                "result": {
                  "const": "succeeded"
                },
                "evidenceDelta": {
                  "type": "object",
                  "properties": {
                    "materialChange": {
                      "const": true
                    }
                  },
                  "required": [
                    "materialChange"
                  ]
                }
              },
              "required": [
                "causeTag",
                "result",
                "evidenceDelta"
              ]
            },
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "causeTag": {
                    "const": "unexplained"
                  }
                },
                "required": [
                  "causeTag"
                ]
              }
            }
          },
          "firstFailure": {
            "$ref": "#/$defs/preservedFailure"
          },
          "successfulAttemptId": {
            "$ref": "#/$defs/id"
          },
          "classificationBasis": {
            "$ref": "#/$defs/recoveredBasis"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcomeClass": {
            "const": "flaky_pass"
          }
        },
        "required": [
          "outcomeClass"
        ]
      },
      "then": {
        "properties": {
          "rootAttempt": {
            "properties": {
              "result": {
                "const": "failed"
              }
            }
          },
          "retries": {
            "minItems": 1,
            "allOf": [
              {
                "$ref": "#/$defs/terminalSuccessfulRetries"
              }
            ],
            "contains": {
              "type": "object",
              "properties": {
                "result": {
                  "const": "succeeded"
                }
              },
              "required": [
                "result"
              ]
            },
            "anyOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "causeTag": {
                      "const": "unexplained"
                    }
                  },
                  "required": [
                    "causeTag"
                  ]
                }
              },
              {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "result": {
                        "const": "succeeded"
                      },
                      "evidenceDelta": {
                        "type": "object",
                        "properties": {
                          "materialChange": {
                            "const": true
                          }
                        },
                        "required": [
                          "materialChange"
                        ]
                      }
                    },
                    "required": [
                      "result",
                      "evidenceDelta"
                    ]
                  }
                }
              }
            ]
          },
          "firstFailure": {
            "$ref": "#/$defs/preservedFailure"
          },
          "successfulAttemptId": {
            "$ref": "#/$defs/id"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "retries": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "causeTag": {
                        "const": "unexplained"
                      }
                    },
                    "required": [
                      "causeTag"
                    ]
                  }
                }
              },
              "required": [
                "retries"
              ]
            },
            "then": {
              "properties": {
                "classificationBasis": {
                  "$ref": "#/$defs/flakyUnexplainedBasis"
                }
              }
            },
            "else": {
              "properties": {
                "classificationBasis": {
                  "$ref": "#/$defs/flakyNoMaterialBasis"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcomeClass": {
            "const": "unresolved_failure"
          }
        },
        "required": [
          "outcomeClass"
        ]
      },
      "then": {
        "properties": {
          "rootAttempt": {
            "properties": {
              "result": {
                "const": "failed"
              }
            }
          },
          "firstFailure": {
            "$ref": "#/$defs/preservedFailure"
          },
          "successfulAttemptId": {
            "type": "null"
          },
          "retries": {
            "items": {
              "properties": {
                "result": {
                  "const": "failed"
                }
              },
              "required": [
                "result"
              ]
            }
          },
          "classificationBasis": {
            "$ref": "#/$defs/unresolvedBasis"
          }
        }
      }
    }
  ],
  "$defs": {
    "succeededRetry": {
      "type": "object",
      "properties": {
        "result": {
          "const": "succeeded"
        }
      },
      "required": [
        "result"
      ]
    },
    "terminalSuccessfulRetries": {
      "type": "array",
      "oneOf": [
        {
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/succeededRetry"
            }
          ]
        },
        {
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {},
            {
              "$ref": "#/$defs/succeededRetry"
            }
          ]
        },
        {
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {},
            {},
            {
              "$ref": "#/$defs/succeededRetry"
            }
          ]
        },
        {
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {},
            {},
            {},
            {
              "$ref": "#/$defs/succeededRetry"
            }
          ]
        },
        {
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {},
            {},
            {},
            {},
            {
              "$ref": "#/$defs/succeededRetry"
            }
          ]
        },
        {
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {},
            {},
            {},
            {},
            {},
            {
              "$ref": "#/$defs/succeededRetry"
            }
          ]
        },
        {
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {},
            {},
            {},
            {},
            {},
            {},
            {
              "$ref": "#/$defs/succeededRetry"
            }
          ]
        },
        {
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {},
            {},
            {},
            {},
            {},
            {},
            {},
            {
              "$ref": "#/$defs/succeededRetry"
            }
          ]
        }
      ]
    },
    "firstPassBasis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "root_succeeded_without_retry"
      }
    },
    "recoveredBasis": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "later_attempt_succeeded",
          "material_evidence_delta",
          "explained_cause",
          "first_failure_preserved"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "later_attempt_succeeded"
          }
        },
        {
          "contains": {
            "const": "material_evidence_delta"
          }
        },
        {
          "contains": {
            "const": "explained_cause"
          }
        },
        {
          "contains": {
            "const": "first_failure_preserved"
          }
        }
      ]
    },
    "flakyUnexplainedBasis": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "later_attempt_succeeded",
          "unexplained_cause",
          "first_failure_preserved"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "later_attempt_succeeded"
          }
        },
        {
          "contains": {
            "const": "unexplained_cause"
          }
        },
        {
          "contains": {
            "const": "first_failure_preserved"
          }
        }
      ]
    },
    "flakyNoMaterialBasis": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "later_attempt_succeeded",
          "explained_cause",
          "first_failure_preserved"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "later_attempt_succeeded"
          }
        },
        {
          "contains": {
            "const": "explained_cause"
          }
        },
        {
          "contains": {
            "const": "first_failure_preserved"
          }
        }
      ]
    },
    "unresolvedBasis": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_attempt_succeeded",
          "first_failure_preserved"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "no_attempt_succeeded"
          }
        },
        {
          "contains": {
            "const": "first_failure_preserved"
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "opaqueReferenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]{1,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rawSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceReference": {
      "type": "object",
      "required": [
        "evidenceId",
        "contentSha256",
        "ciphertextSha256"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/opaqueReferenceId"
        },
        "contentSha256": {
          "$ref": "#/$defs/rawSha256"
        },
        "ciphertextSha256": {
          "$ref": "#/$defs/rawSha256"
        }
      },
      "additionalProperties": false
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "evaluatorReceipt": {
      "type": "object",
      "required": [
        "evaluatorId",
        "evaluatorVersion",
        "inputDigest",
        "receipt"
      ],
      "properties": {
        "evaluatorId": {
          "$ref": "#/$defs/id"
        },
        "evaluatorVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "receipt": {
          "$ref": "#/$defs/evidenceReference"
        }
      },
      "additionalProperties": false
    },
    "outcomeClass": {
      "enum": [
        "first_pass_success",
        "recovered_success",
        "flaky_pass",
        "unresolved_failure"
      ]
    },
    "classification": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "evaluator"
          ],
          "properties": {
            "status": {
              "const": "evaluated"
            },
            "evaluator": {
              "allOf": [
                {
                  "$ref": "#/$defs/evaluatorReceipt"
                },
                {
                  "properties": {
                    "evaluatorId": {
                      "const": "graphhelm-jpd/retry-classifier"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "refusal"
          ],
          "properties": {
            "status": {
              "const": "capability_missing"
            },
            "refusal": {
              "type": "object",
              "required": [
                "code",
                "missingCapability",
                "reason"
              ],
              "properties": {
                "code": {
                  "const": "RETRY_CLASSIFIER_MISSING"
                },
                "missingCapability": {
                  "const": "graphhelm-jpd/retry-classifier"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "lineageValidation": {
      "type": "object",
      "required": [
        "status",
        "result",
        "evaluator"
      ],
      "properties": {
        "status": {
          "const": "evaluated"
        },
        "result": {
          "const": "valid"
        },
        "evaluator": {
          "allOf": [
            {
              "$ref": "#/$defs/evaluatorReceipt"
            },
            {
              "properties": {
                "evaluatorId": {
                  "const": "graphhelm-jpd/retry-lineage-validator"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "rootAttempt": {
      "type": "object",
      "required": [
        "attemptId",
        "ordinal",
        "retryOf",
        "causeTag",
        "result",
        "startedAt",
        "endedAt",
        "inputDigest",
        "evidenceRefs"
      ],
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/id"
        },
        "ordinal": {
          "const": 1
        },
        "retryOf": {
          "type": "null"
        },
        "causeTag": {
          "const": "initial_attempt"
        },
        "result": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "retryAttempt": {
      "type": "object",
      "required": [
        "attemptId",
        "ordinal",
        "retryOf",
        "causeTag",
        "result",
        "startedAt",
        "endedAt",
        "inputDigest",
        "evidenceRefs",
        "evidenceDelta"
      ],
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/id"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9
        },
        "retryOf": {
          "$ref": "#/$defs/id"
        },
        "causeTag": {
          "enum": [
            "product_fix",
            "environment_recovery",
            "test_repair",
            "dependency_recovery",
            "unexplained"
          ]
        },
        "result": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "evidenceDelta": {
          "type": "object",
          "required": [
            "added",
            "removed",
            "materialChange"
          ],
          "properties": {
            "added": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "removed": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "materialChange": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "preservedFailure": {
      "type": "object",
      "required": [
        "attemptId",
        "evidenceRefs",
        "summary"
      ],
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/id"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
