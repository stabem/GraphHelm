{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/retry-lineage-validation-policy.schema.json",
  "title": "GraphHelm JPD Retry Lineage Validation Policy Contract",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "p50.dev/jpd/v1"
    },
    "kind": {
      "const": "RetryLineageValidationPolicyContract"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "graphhelm-jpd/retry-lineage-validation"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "runtimeStatus",
        "requiresRegisteredEvaluator",
        "evaluationSemantics",
        "inputSchema",
        "outputSchema",
        "outputField",
        "evaluationOrder",
        "requiredChecks",
        "success",
        "refusal",
        "nonNormativeDescriptions"
      ],
      "properties": {
        "runtimeStatus": {
          "const": "declarative_only"
        },
        "requiresRegisteredEvaluator": {
          "const": true
        },
        "evaluationSemantics": {
          "const": "deterministic_when_registered"
        },
        "inputSchema": {
          "const": "https://p50.dev/extensions/graphhelm-jpd/schemas/retry-lineage-input.schema.json"
        },
        "outputSchema": {
          "const": "https://p50.dev/extensions/graphhelm-jpd/schemas/retry-chain-input.schema.json"
        },
        "outputField": {
          "const": "lineageValidation"
        },
        "evaluationOrder": {
          "const": "all_checks_required"
        },
        "requiredChecks": {
          "$ref": "#/$defs/requiredChecks"
        },
        "success": {
          "type": "object",
          "required": [
            "status",
            "result",
            "evaluatorId"
          ],
          "properties": {
            "status": {
              "const": "evaluated"
            },
            "result": {
              "const": "valid"
            },
            "evaluatorId": {
              "const": "graphhelm-jpd/retry-lineage-validator"
            }
          },
          "additionalProperties": false
        },
        "refusal": {
          "type": "object",
          "required": [
            "code",
            "failureKind",
            "waivable"
          ],
          "properties": {
            "code": {
              "const": "RETRY_LINEAGE_INVALID"
            },
            "failureKind": {
              "const": "structural_impossibility"
            },
            "waivable": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "nonNormativeDescriptions": {
          "type": "object",
          "required": [
            "purpose"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "check": {
      "enum": [
        "root_attempt_id_matches",
        "attempt_ids_unique",
        "ordinals_contiguous",
        "retry_edges_adjacent",
        "retry_edges_acyclic",
        "timestamps_monotonic",
        "successful_attempt_exists_and_succeeded",
        "first_failure_matches_root",
        "evidence_deltas_digest_bound"
      ]
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/check"
      },
      "allOf": [
        {
          "contains": {
            "const": "root_attempt_id_matches"
          }
        },
        {
          "contains": {
            "const": "attempt_ids_unique"
          }
        },
        {
          "contains": {
            "const": "ordinals_contiguous"
          }
        },
        {
          "contains": {
            "const": "retry_edges_adjacent"
          }
        },
        {
          "contains": {
            "const": "retry_edges_acyclic"
          }
        },
        {
          "contains": {
            "const": "timestamps_monotonic"
          }
        },
        {
          "contains": {
            "const": "successful_attempt_exists_and_succeeded"
          }
        },
        {
          "contains": {
            "const": "first_failure_matches_root"
          }
        },
        {
          "contains": {
            "const": "evidence_deltas_digest_bound"
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
