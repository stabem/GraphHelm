{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/skill-capsule.schema.json",
  "title": "GraphHelm JPD Skill Capsule",
  "type": "object",
  "required": [
    "capsuleId",
    "name",
    "version",
    "scope",
    "status",
    "source",
    "lifecycle",
    "authority",
    "entrySkillIds",
    "requiredCapabilities",
    "contractRefs",
    "obligationBindings",
    "requiredObservers",
    "immutableResourceDigests",
    "promotion",
    "governance"
  ],
  "properties": {
    "capsuleId": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "scope": {
      "const": "task"
    },
    "status": {
      "const": "draft"
    },
    "source": {
      "type": "object",
      "required": [
        "taskId",
        "generatedAt",
        "author",
        "sourceJourney",
        "bindings",
        "generatorSkillId",
        "generatorSkillVersion"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "author": {
          "$ref": "#/$defs/actor"
        },
        "sourceJourney": {
          "$ref": "#/$defs/sourceJourney"
        },
        "bindings": {
          "$ref": "#/$defs/sourceBindings"
        },
        "generatorSkillId": {
          "const": "skill-synthesizer"
        },
        "generatorSkillVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "reviewAt",
        "expiresAt",
        "onExpiry"
      ],
      "properties": {
        "reviewAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "onExpiry": {
          "const": "suspend"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "$ref": "#/$defs/candidateAuthority"
    },
    "entrySkillIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "contractRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contractReference"
      }
    },
    "obligationBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/obligationBinding"
      }
    },
    "requiredObservers": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/observerRequirement"
      }
    },
    "immutableResourceDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "promotion": {
      "$ref": "#/$defs/promotion"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "candidateAuthority": {
      "type": "object",
      "required": [
        "status",
        "validation"
      ],
      "properties": {
        "status": {
          "const": "candidate"
        },
        "validation": {
          "type": "object",
          "required": [
            "status",
            "code",
            "missingCapability",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "capability_missing"
            },
            "code": {
              "const": "SKILL_CAPSULE_VALIDATOR_MISSING"
            },
            "missingCapability": {
              "const": "jpd.registered-deterministic-skill-capsule-validator"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "opaqueReferenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]{1,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "actor": {
      "type": "object",
      "required": [
        "actorId",
        "actorType"
      ],
      "properties": {
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "actorType": {
          "enum": [
            "human",
            "agent",
            "service"
          ]
        }
      },
      "additionalProperties": false
    },
    "sourceJourney": {
      "type": "object",
      "required": [
        "artifactType",
        "schemaId",
        "contractId",
        "contractVersion",
        "contractDigest"
      ],
      "properties": {
        "artifactType": {
          "const": "journey_contract"
        },
        "schemaId": {
          "const": "https://p50.dev/extensions/graphhelm-jpd/schemas/journey-contract.schema.json"
        },
        "contractId": {
          "$ref": "#/$defs/id"
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1
        },
        "contractDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "sourceBindings": {
      "type": "object",
      "required": [
        "graph",
        "code"
      ],
      "properties": {
        "graph": {
          "$ref": "#/$defs/graphBinding"
        },
        "code": {
          "$ref": "#/$defs/codeBinding"
        }
      },
      "additionalProperties": false
    },
    "graphBinding": {
      "type": "object",
      "required": [
        "graphId",
        "version",
        "semanticHash"
      ],
      "properties": {
        "graphId": {
          "$ref": "#/$defs/opaqueReferenceId"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "semanticHash": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "codeBinding": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "revisionAlgorithm",
        "dirty",
        "snapshotDigest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "revisionAlgorithm": {
          "enum": [
            "git-sha1",
            "git-sha256"
          ]
        },
        "dirty": {
          "const": false
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "revisionAlgorithm": {
                "const": "git-sha1"
              }
            },
            "required": [
              "revisionAlgorithm"
            ]
          },
          "then": {
            "properties": {
              "revision": {
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "contractReference": {
      "type": "object",
      "required": [
        "contractId",
        "schemaId",
        "digest"
      ],
      "properties": {
        "contractId": {
          "$ref": "#/$defs/id"
        },
        "schemaId": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 512
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "obligationBinding": {
      "type": "object",
      "required": [
        "artifactType",
        "schemaId",
        "obligationId",
        "obligationDigest",
        "contractId",
        "contractDigest",
        "promiseId",
        "requiredObserverCapability"
      ],
      "properties": {
        "artifactType": {
          "const": "observation_obligation"
        },
        "schemaId": {
          "const": "https://p50.dev/extensions/graphhelm-jpd/schemas/observation-obligation.schema.json"
        },
        "obligationId": {
          "$ref": "#/$defs/id"
        },
        "obligationDigest": {
          "$ref": "#/$defs/digest"
        },
        "contractId": {
          "$ref": "#/$defs/id"
        },
        "contractDigest": {
          "$ref": "#/$defs/digest"
        },
        "promiseId": {
          "$ref": "#/$defs/id"
        },
        "requiredObserverCapability": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "observerRequirement": {
      "type": "object",
      "required": [
        "observerId",
        "observerVersion",
        "contractDigest"
      ],
      "properties": {
        "observerId": {
          "$ref": "#/$defs/id"
        },
        "observerVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "contractDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "capabilityId",
        "capabilityVersion",
        "providerExtensionId",
        "providerExtensionVersion",
        "contractDigest",
        "publicSurface",
        "effects",
        "permissions"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/id"
        },
        "capabilityVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "providerExtensionId": {
          "$ref": "#/$defs/id"
        },
        "providerExtensionVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "contractDigest": {
          "$ref": "#/$defs/digest"
        },
        "publicSurface": {
          "enum": [
            "cli",
            "mcp",
            "http"
          ]
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_only",
              "local_artifact_write",
              "runtime_read",
              "runtime_mutation",
              "external_read",
              "external_mutation"
            ]
          }
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "network.external",
              "network.loopback",
              "owner.decision.request",
              "package.read",
              "runtime.read",
              "runtime.write",
              "token.reference.read",
              "workspace.artifact.write"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effects": {
                "contains": {
                  "const": "read_only"
                }
              }
            },
            "required": [
              "effects"
            ]
          },
          "then": {
            "properties": {
              "effects": {
                "not": {
                  "contains": {
                    "enum": [
                      "local_artifact_write",
                      "runtime_mutation",
                      "external_mutation"
                    ]
                  }
                }
              },
              "permissions": {
                "not": {
                  "contains": {
                    "enum": [
                      "owner.decision.request",
                      "runtime.write",
                      "workspace.artifact.write"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effects": {
                "contains": {
                  "const": "local_artifact_write"
                }
              }
            },
            "required": [
              "effects"
            ]
          },
          "then": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "workspace.artifact.write"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effects": {
                "contains": {
                  "const": "runtime_read"
                }
              }
            },
            "required": [
              "effects"
            ]
          },
          "then": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "runtime.read"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effects": {
                "contains": {
                  "const": "runtime_mutation"
                }
              }
            },
            "required": [
              "effects"
            ]
          },
          "then": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "runtime.write"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effects": {
                "contains": {
                  "enum": [
                    "external_read",
                    "external_mutation"
                  ]
                }
              }
            },
            "required": [
              "effects"
            ]
          },
          "then": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "network.external"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "publicSurface": {
                "enum": [
                  "mcp",
                  "http"
                ]
              }
            },
            "required": [
              "publicSurface"
            ]
          },
          "then": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "network.loopback"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "publicSurface": {
                "const": "mcp"
              }
            },
            "required": [
              "publicSurface"
            ]
          },
          "then": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "token.reference.read"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "workspace.artifact.write"
                }
              }
            },
            "required": [
              "permissions"
            ]
          },
          "then": {
            "properties": {
              "effects": {
                "contains": {
                  "const": "local_artifact_write"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "runtime.read"
                }
              }
            },
            "required": [
              "permissions"
            ]
          },
          "then": {
            "properties": {
              "effects": {
                "contains": {
                  "const": "runtime_read"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "runtime.write"
                }
              }
            },
            "required": [
              "permissions"
            ]
          },
          "then": {
            "properties": {
              "effects": {
                "contains": {
                  "const": "runtime_mutation"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "network.external"
                }
              }
            },
            "required": [
              "permissions"
            ]
          },
          "then": {
            "properties": {
              "effects": {
                "contains": {
                  "enum": [
                    "external_read",
                    "external_mutation"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "permissions": {
                "contains": {
                  "const": "owner.decision.request"
                }
              }
            },
            "required": [
              "permissions"
            ]
          },
          "then": {
            "properties": {
              "effects": {
                "contains": {
                  "const": "runtime_mutation"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "required": [
        "eligible",
        "distinctSuccessfulRuns",
        "minimumDistinctRuns",
        "evidenceFresh",
        "tokenBudgetWithinLimit",
        "unresolvedSevereClaims",
        "reasons"
      ],
      "properties": {
        "eligible": {
          "const": false
        },
        "distinctSuccessfulRuns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "minimumDistinctRuns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "evidenceFresh": {
          "type": "boolean"
        },
        "tokenBudgetWithinLimit": {
          "type": "boolean"
        },
        "unresolvedSevereClaims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": [
        "publicationAuthority",
        "selfActivationAllowed",
        "operationalGraphMutationAllowed",
        "publication"
      ],
      "properties": {
        "publicationAuthority": {
          "const": "graph_governor"
        },
        "selfActivationAllowed": {
          "const": false
        },
        "operationalGraphMutationAllowed": {
          "const": false
        },
        "publication": {
          "type": "null"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
