{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/skill-evaluation.schema.json",
  "title": "GraphHelm JPD Skill Evaluation",
  "type": "object",
  "required": [
    "evaluationId",
    "capsuleId",
    "evaluatedAt",
    "authority",
    "classification",
    "runSamples",
    "aggregates",
    "counterexamples",
    "disagreements",
    "agentAgreementIsEvidence",
    "promotionDecision"
  ],
  "properties": {
    "evaluationId": {
      "$ref": "#/$defs/id"
    },
    "capsuleId": {
      "$ref": "#/$defs/id"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "authority": {
      "$ref": "#/$defs/candidateAuthority"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "runSamples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/runSample"
      }
    },
    "aggregates": {
      "type": "object",
      "required": [
        "distinctRuns",
        "evidenceCoverage",
        "errorReduction",
        "tokenOverheadRatio",
        "generalizationScore",
        "allEvidenceFresh"
      ],
      "properties": {
        "distinctRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "evidenceCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "errorReduction": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "tokenOverheadRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "generalizationScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allEvidenceFresh": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "counterexamples": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "claimId",
          "severity",
          "status"
        ],
        "properties": {
          "claimId": {
            "$ref": "#/$defs/id"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "falsified",
              "unresolved"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "disagreements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/disagreement"
      }
    },
    "agentAgreementIsEvidence": {
      "const": false
    },
    "promotionDecision": {
      "$ref": "#/$defs/promotionDecision"
    }
  },
  "$defs": {
    "candidateAuthority": {
      "type": "object",
      "required": [
        "status",
        "effect",
        "capsuleValidation"
      ],
      "properties": {
        "status": {
          "const": "candidate"
        },
        "effect": {
          "const": "advisory_only"
        },
        "capsuleValidation": {
          "type": "object",
          "required": [
            "status",
            "code",
            "missingCapability",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "capability_missing"
            },
            "code": {
              "const": "SKILL_CAPSULE_VALIDATOR_MISSING"
            },
            "missingCapability": {
              "const": "jpd.registered-deterministic-skill-capsule-validator"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "opaqueReferenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]{1,128}$"
    },
    "rawSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceReference": {
      "type": "object",
      "required": [
        "evidenceId",
        "contentSha256",
        "ciphertextSha256"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/opaqueReferenceId"
        },
        "contentSha256": {
          "$ref": "#/$defs/rawSha256"
        },
        "ciphertextSha256": {
          "$ref": "#/$defs/rawSha256"
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "status",
        "refusal"
      ],
      "properties": {
        "status": {
          "const": "capability_missing"
        },
        "refusal": {
          "type": "object",
          "required": [
            "code",
            "missingCapability",
            "reason"
          ],
          "properties": {
            "code": {
              "const": "SKILL_EVALUATOR_MISSING"
            },
            "missingCapability": {
              "const": "jpd.registered-deterministic-evaluator"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runSample": {
      "type": "object",
      "required": [
        "journeyRunId",
        "result",
        "evidenceCoverage",
        "tokenCost",
        "defectsBefore",
        "defectsAfter",
        "evidenceFresh",
        "firstFailurePreserved"
      ],
      "properties": {
        "journeyRunId": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "enum": [
            "first_pass_success",
            "recovered_success",
            "flaky_pass",
            "unresolved_failure"
          ]
        },
        "evidenceCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tokenCost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "defectsBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "defectsAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "evidenceFresh": {
          "type": "boolean"
        },
        "firstFailurePreserved": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "disagreement": {
      "type": "object",
      "required": [
        "claimA",
        "claimB",
        "evidenceForA",
        "evidenceForB",
        "discriminatingCheck",
        "status"
      ],
      "properties": {
        "claimA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "claimB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "evidenceForA": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "evidenceForB": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "discriminatingCheck": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved",
            "observer_missing"
          ]
        }
      },
      "additionalProperties": false
    },
    "promotionDecision": {
      "type": "object",
      "required": [
        "status",
        "eligible",
        "reasons",
        "requiredAction",
        "proposal"
      ],
      "properties": {
        "status": {
          "const": "advisory"
        },
        "eligible": {
          "const": false
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "requiredAction": {
          "const": "register_evaluator"
        },
        "proposal": {
          "type": "null"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
