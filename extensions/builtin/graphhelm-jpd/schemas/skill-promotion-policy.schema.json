{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/extensions/graphhelm-jpd/schemas/skill-promotion-policy.schema.json",
  "title": "GraphHelm JPD Skill Promotion Policy Contract",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "p50.dev/jpd/v1" },
    "kind": { "const": "SkillPromotionPolicyContract" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "graphhelm-jpd/skill-promotion" },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "runtimeStatus",
        "requiresRegisteredEvaluator",
        "evaluationSemantics",
        "inputSchema",
        "outputSchema",
        "evaluationOrder",
        "thresholds",
        "actionPrecedence",
        "denyWhen",
        "onPass",
        "onFail",
        "nonNormativeDescriptions"
      ],
      "properties": {
        "runtimeStatus": { "const": "declarative_only" },
        "requiresRegisteredEvaluator": { "const": true },
        "evaluationSemantics": { "const": "deterministic_when_registered" },
        "inputSchema": {
          "const": "https://p50.dev/extensions/graphhelm-jpd/schemas/skill-promotion-policy.schema.json#evaluation-input"
        },
        "outputSchema": {
          "const": "https://p50.dev/extensions/graphhelm-jpd/schemas/skill-promotion-policy.schema.json#evaluation-output"
        },
        "evaluationOrder": { "const": "collect_all_denials_then_action_precedence" },
        "thresholds": { "$ref": "#/$defs/thresholds" },
        "actionPrecedence": { "$ref": "#/$defs/actionPrecedence" },
        "denyWhen": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            { "$ref": "#/$defs/successfulRunsRule" },
            { "$ref": "#/$defs/evidenceCoverageRule" },
            { "$ref": "#/$defs/generalizationRule" },
            { "$ref": "#/$defs/errorReductionRule" },
            { "$ref": "#/$defs/staleEvidenceRule" },
            { "$ref": "#/$defs/materialCounterexampleRule" },
            { "$ref": "#/$defs/firstFailureRule" },
            { "$ref": "#/$defs/tokenOverheadRule" },
            { "$ref": "#/$defs/observerMissingRule" }
          ],
          "items": false
        },
        "onPass": { "$ref": "#/$defs/onPass" },
        "onFail": { "$ref": "#/$defs/onFail" },
        "nonNormativeDescriptions": { "$ref": "#/$defs/nonNormativeDescriptions" }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": [
        "minimumDistinctSuccessfulRuns",
        "minimumEvidenceCoverage",
        "minimumGeneralizationScore",
        "minimumErrorReduction",
        "maximumTokenOverheadRatio",
        "maximumUnresolvedHighOrCriticalClaims"
      ],
      "properties": {
        "minimumDistinctSuccessfulRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "minimumEvidenceCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumGeneralizationScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumErrorReduction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumTokenOverheadRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "maximumUnresolvedHighOrCriticalClaims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    },
    "action": {
      "enum": [
        "resolve_counterexample",
        "refresh_evidence",
        "reduce_token_cost",
        "gather_more_evidence"
      ]
    },
    "actionPrecedence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "const": "resolve_counterexample" },
        { "const": "refresh_evidence" },
        { "const": "reduce_token_cost" },
        { "const": "gather_more_evidence" }
      ],
      "items": false
    },
    "reasonCode": {
      "enum": [
        "INSUFFICIENT_SUCCESSFUL_RUNS",
        "INSUFFICIENT_EVIDENCE_COVERAGE",
        "INSUFFICIENT_GENERALIZATION",
        "INSUFFICIENT_ERROR_REDUCTION",
        "STALE_REQUIRED_EVIDENCE",
        "UNRESOLVED_MATERIAL_COUNTEREXAMPLE",
        "FIRST_FAILURE_PROVENANCE_MISSING",
        "TOKEN_OVERHEAD_EXCEEDED",
        "OBSERVER_MISSING"
      ]
    },
    "onDeny": {
      "type": "object",
      "required": ["reasonCode", "requiredAction"],
      "properties": {
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "requiredAction": { "$ref": "#/$defs/action" }
      },
      "additionalProperties": false
    },
    "ruleBase": {
      "type": "object",
      "required": ["id", "predicate", "onDeny"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "predicate": { "type": "object" },
        "onDeny": { "$ref": "#/$defs/onDeny" }
      },
      "additionalProperties": false
    },
    "successfulRunsPredicate": {
      "type": "object",
      "required": ["kind", "collection", "distinctBy", "where", "compare"],
      "properties": {
        "kind": { "const": "distinct_filtered_count" },
        "collection": { "const": "runSamples" },
        "distinctBy": { "const": "journeyRunId" },
        "where": {
          "type": "object",
          "required": ["field", "operator", "values"],
          "properties": {
            "field": { "const": "result" },
            "operator": { "const": "in" },
            "values": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "const": "first_pass_success" },
                { "const": "recovered_success" }
              ],
              "items": false
            }
          },
          "additionalProperties": false
        },
        "compare": {
          "type": "object",
          "required": ["operator", "thresholdRef"],
          "properties": {
            "operator": { "const": "less_than" },
            "thresholdRef": { "const": "minimumDistinctSuccessfulRuns" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidenceCoveragePredicate": {
      "$ref": "#/$defs/minimumNumericPredicate",
      "properties": {
        "field": { "const": "aggregates.evidenceCoverage" },
        "thresholdRef": { "const": "minimumEvidenceCoverage" }
      }
    },
    "generalizationPredicate": {
      "$ref": "#/$defs/minimumNumericPredicate",
      "properties": {
        "field": { "const": "aggregates.generalizationScore" },
        "thresholdRef": { "const": "minimumGeneralizationScore" }
      }
    },
    "errorReductionPredicate": {
      "$ref": "#/$defs/minimumNumericPredicate",
      "properties": {
        "field": { "const": "aggregates.errorReduction" },
        "thresholdRef": { "const": "minimumErrorReduction" }
      }
    },
    "minimumNumericPredicate": {
      "type": "object",
      "required": ["kind", "field", "operator", "thresholdRef"],
      "properties": {
        "kind": { "const": "numeric_compare" },
        "field": { "type": "string" },
        "operator": { "const": "less_than" },
        "thresholdRef": { "type": "string" }
      },
      "additionalProperties": false
    },
    "staleEvidencePredicate": {
      "type": "object",
      "required": ["kind", "field", "operator", "value"],
      "properties": {
        "kind": { "const": "boolean_compare" },
        "field": { "const": "aggregates.allEvidenceFresh" },
        "operator": { "const": "equals" },
        "value": { "const": false }
      },
      "additionalProperties": false
    },
    "materialCounterexamplePredicate": {
      "type": "object",
      "required": ["kind", "collection", "whereAll", "compare"],
      "properties": {
        "kind": { "const": "filtered_count" },
        "collection": { "const": "counterexamples" },
        "whereAll": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "required": ["field", "operator", "values"],
              "properties": {
                "field": { "const": "severity" },
                "operator": { "const": "in" },
                "values": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [{ "const": "high" }, { "const": "critical" }],
                  "items": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["field", "operator", "values"],
              "properties": {
                "field": { "const": "status" },
                "operator": { "const": "in" },
                "values": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [{ "const": "confirmed" }, { "const": "unresolved" }],
                  "items": false
                }
              },
              "additionalProperties": false
            }
          ],
          "items": false
        },
        "compare": {
          "type": "object",
          "required": ["operator", "thresholdRef"],
          "properties": {
            "operator": { "const": "greater_than" },
            "thresholdRef": { "const": "maximumUnresolvedHighOrCriticalClaims" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "firstFailurePredicate": {
      "type": "object",
      "required": ["kind", "collection", "whereAll"],
      "properties": {
        "kind": { "const": "any_item_matches" },
        "collection": { "const": "runSamples" },
        "whereAll": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "required": ["field", "operator", "values"],
              "properties": {
                "field": { "const": "result" },
                "operator": { "const": "in" },
                "values": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "prefixItems": [
                    { "const": "recovered_success" },
                    { "const": "flaky_pass" },
                    { "const": "unresolved_failure" }
                  ],
                  "items": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["field", "operator", "value"],
              "properties": {
                "field": { "const": "firstFailurePreserved" },
                "operator": { "const": "equals" },
                "value": { "const": false }
              },
              "additionalProperties": false
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "tokenOverheadPredicate": {
      "type": "object",
      "required": ["kind", "field", "operator", "thresholdRef"],
      "properties": {
        "kind": { "const": "numeric_compare" },
        "field": { "const": "aggregates.tokenOverheadRatio" },
        "operator": { "const": "greater_than" },
        "thresholdRef": { "const": "maximumTokenOverheadRatio" }
      },
      "additionalProperties": false
    },
    "observerMissingPredicate": {
      "type": "object",
      "required": ["kind", "field"],
      "properties": {
        "kind": { "const": "array_not_empty" },
        "field": { "const": "missingObserverCapabilityIds" }
      },
      "additionalProperties": false
    },
    "successfulRunsRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "insufficient-distinct-successful-runs" },
            "predicate": { "$ref": "#/$defs/successfulRunsPredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "INSUFFICIENT_SUCCESSFUL_RUNS" },
                "requiredAction": { "const": "gather_more_evidence" }
              }
            }
          }
        }
      ]
    },
    "evidenceCoverageRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "insufficient-evidence-coverage" },
            "predicate": { "$ref": "#/$defs/evidenceCoveragePredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "INSUFFICIENT_EVIDENCE_COVERAGE" },
                "requiredAction": { "const": "gather_more_evidence" }
              }
            }
          }
        }
      ]
    },
    "generalizationRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "insufficient-generalization" },
            "predicate": { "$ref": "#/$defs/generalizationPredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "INSUFFICIENT_GENERALIZATION" },
                "requiredAction": { "const": "gather_more_evidence" }
              }
            }
          }
        }
      ]
    },
    "errorReductionRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "insufficient-error-reduction" },
            "predicate": { "$ref": "#/$defs/errorReductionPredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "INSUFFICIENT_ERROR_REDUCTION" },
                "requiredAction": { "const": "gather_more_evidence" }
              }
            }
          }
        }
      ]
    },
    "staleEvidenceRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "stale-required-evidence" },
            "predicate": { "$ref": "#/$defs/staleEvidencePredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "STALE_REQUIRED_EVIDENCE" },
                "requiredAction": { "const": "refresh_evidence" }
              }
            }
          }
        }
      ]
    },
    "materialCounterexampleRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "material-counterexample-remains" },
            "predicate": { "$ref": "#/$defs/materialCounterexamplePredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "UNRESOLVED_MATERIAL_COUNTEREXAMPLE" },
                "requiredAction": { "const": "resolve_counterexample" }
              }
            }
          }
        }
      ]
    },
    "firstFailureRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "first-failure-provenance-missing" },
            "predicate": { "$ref": "#/$defs/firstFailurePredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "FIRST_FAILURE_PROVENANCE_MISSING" },
                "requiredAction": { "const": "gather_more_evidence" }
              }
            }
          }
        }
      ]
    },
    "tokenOverheadRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "token-overhead-exceeded" },
            "predicate": { "$ref": "#/$defs/tokenOverheadPredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "TOKEN_OVERHEAD_EXCEEDED" },
                "requiredAction": { "const": "reduce_token_cost" }
              }
            }
          }
        }
      ]
    },
    "observerMissingRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "properties": {
            "id": { "const": "required-observer-capability-missing" },
            "predicate": { "$ref": "#/$defs/observerMissingPredicate" },
            "onDeny": {
              "properties": {
                "reasonCode": { "const": "OBSERVER_MISSING" },
                "requiredAction": { "const": "gather_more_evidence" }
              }
            }
          }
        }
      ]
    },
    "onPass": {
      "type": "object",
      "required": ["action", "targetScope", "activation", "requiredPublisher"],
      "properties": {
        "action": { "const": "propose_promotion" },
        "targetScope": { "const": "project" },
        "activation": { "const": false },
        "requiredPublisher": { "const": "graph_governor" }
      },
      "additionalProperties": false
    },
    "onFail": {
      "type": "object",
      "required": ["action", "activation"],
      "properties": {
        "action": { "const": "keep_task_capsule" },
        "activation": { "const": false }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "runResult": {
      "enum": [
        "first_pass_success",
        "recovered_success",
        "flaky_pass",
        "unresolved_failure"
      ]
    },
    "evaluationInput": {
      "$anchor": "evaluation-input",
      "type": "object",
      "required": [
        "runSamples",
        "aggregates",
        "counterexamples",
        "missingObserverCapabilityIds"
      ],
      "properties": {
        "runSamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["journeyRunId", "result", "firstFailurePreserved"],
            "properties": {
              "journeyRunId": { "$ref": "#/$defs/id" },
              "result": { "$ref": "#/$defs/runResult" },
              "firstFailurePreserved": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "aggregates": {
          "type": "object",
          "required": [
            "evidenceCoverage",
            "generalizationScore",
            "errorReduction",
            "tokenOverheadRatio",
            "allEvidenceFresh"
          ],
          "properties": {
            "evidenceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
            "generalizationScore": { "type": "number", "minimum": 0, "maximum": 1 },
            "errorReduction": { "type": "number", "minimum": -1, "maximum": 1 },
            "tokenOverheadRatio": { "type": "number", "minimum": 0, "maximum": 100 },
            "allEvidenceFresh": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "counterexamples": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["severity", "status"],
            "properties": {
              "severity": { "enum": ["low", "medium", "high", "critical"] },
              "status": { "enum": ["confirmed", "falsified", "unresolved"] }
            },
            "additionalProperties": false
          }
        },
        "missingObserverCapabilityIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "required": ["proposalId", "targetScope", "requestedAuthority"],
      "properties": {
        "proposalId": { "$ref": "#/$defs/id" },
        "targetScope": { "const": "project" },
        "requestedAuthority": { "const": "graph_governor" }
      },
      "additionalProperties": false
    },
    "evaluationOutput": {
      "$anchor": "evaluation-output",
      "type": "object",
      "required": ["eligible", "reasonCodes", "requiredAction", "proposal"],
      "properties": {
        "eligible": { "type": "boolean" },
        "reasonCodes": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        },
        "requiredAction": {
          "oneOf": [
            { "$ref": "#/$defs/action" },
            { "const": "governor_review" }
          ]
        },
        "proposal": {
          "oneOf": [
            { "$ref": "#/$defs/proposal" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "eligible": { "const": true } },
            "required": ["eligible"]
          },
          "then": {
            "properties": {
              "reasonCodes": { "maxItems": 0 },
              "requiredAction": { "const": "governor_review" },
              "proposal": { "$ref": "#/$defs/proposal" }
            }
          },
          "else": {
            "properties": {
              "reasonCodes": { "minItems": 1 },
              "requiredAction": { "$ref": "#/$defs/action" },
              "proposal": { "type": "null" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "nonNormativeDescriptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "additionalProperties": false
}
