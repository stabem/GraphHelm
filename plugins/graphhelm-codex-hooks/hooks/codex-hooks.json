{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session_hook.py\" start --host codex",
            "statusMessage": "Loading Keel and GraphHelm context",
            "timeout": 10,
            "additionalContextLimit": 512
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session_hook.py\" end --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/subagent_hook.py\" start --host codex",
            "statusMessage": "Recording GraphHelm subagent start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/subagent_hook.py\" stop --host codex",
            "statusMessage": "Recording GraphHelm subagent stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
