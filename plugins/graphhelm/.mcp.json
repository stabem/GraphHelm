{
  "mcpServers": {
    "graphhelm": {
      "command": "${GRAPHHELM_CLI:-graphhelm}",
      "args": [
        "mcp",
        "--url",
        "${GRAPHHELM_RUNTIME_URL:-http://127.0.0.1:8791}",
        "--token-file",
        "${GRAPHHELM_TOKEN_FILE}",
        "--actor",
        "agent-chat"
      ]
    }
  }
}
