{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/schemas/activation-receipt.schema.json",
  "x-graphhelm-schema-version": "1.0.0",
  "description": "Evidence claims, not trust. Only independently held observer custody can authorize verified adoption; parsing this document never grants custody.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "digest", "spec"],
  "properties": {
    "apiVersion": {"const": "p50.dev/adoption/v1"},
    "kind": {"const": "ActivationReceipt"},
    "digest": {"$ref": "#/$defs/digest"},
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["transactionId", "planDigest", "host", "environment", "configDigests", "packageDigests", "session", "observer", "mcp", "methodology", "timestamps"],
      "properties": {
        "transactionId": {"$ref": "#/$defs/hash"},
        "planDigest": {"$ref": "#/$defs/digest"},
        "host": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"enum": ["claude", "codex"]}, "version": {"$ref": "#/$defs/id"}}},
        "environment": {"type": "object", "additionalProperties": false, "required": ["project", "home"], "properties": {"project": {"$ref": "#/$defs/hash"}, "home": {"$ref": "#/$defs/hash"}}},
        "configDigests": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["root", "path", "digest"], "properties": {"root": {"enum": ["project", "home"]}, "path": {"type": "string", "minLength": 1, "maxLength": 4096}, "digest": {"$ref": "#/$defs/hash"}}}},
        "packageDigests": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"}}}},
        "session": {"type": "object", "additionalProperties": false, "required": ["id", "previousId", "startedAtUnixMs"], "properties": {"id": {"$ref": "#/$defs/id"}, "previousId": {"$ref": "#/$defs/id"}, "startedAtUnixMs": {"$ref": "#/$defs/time"}}},
        "observer": {"type": "object", "additionalProperties": false, "required": ["identity", "custodyId", "kind", "evidenceDigest"], "properties": {"identity": {"$ref": "#/$defs/id"}, "custodyId": {"$ref": "#/$defs/id"}, "kind": {"enum": ["host_observer", "fixture"]}, "evidenceDigest": {"$ref": "#/$defs/digest"}}},
        "mcp": {"type": "object", "additionalProperties": false, "required": ["tool", "operation", "requestId", "runtimeObservationDigest", "sessionId", "observedAtUnixMs"], "properties": {"tool": {"const": "graphhelm"}, "operation": {"const": "list"}, "requestId": {"$ref": "#/$defs/id"}, "runtimeObservationDigest": {"$ref": "#/$defs/digest"}, "sessionId": {"$ref": "#/$defs/id"}, "observedAtUnixMs": {"$ref": "#/$defs/time"}}},
        "methodology": {"type": "object", "additionalProperties": false, "required": ["loaded", "oldMethodInactive", "evidenceDigest"], "properties": {"loaded": {"const": true}, "oldMethodInactive": {"const": true}, "evidenceDigest": {"$ref": "#/$defs/digest"}}},
        "timestamps": {"type": "object", "additionalProperties": false, "required": ["installedAtUnixMs", "observedAtUnixMs", "expiresAtUnixMs"], "properties": {"installedAtUnixMs": {"$ref": "#/$defs/time"}, "observedAtUnixMs": {"$ref": "#/$defs/time"}, "expiresAtUnixMs": {"$ref": "#/$defs/time"}}}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "time": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
