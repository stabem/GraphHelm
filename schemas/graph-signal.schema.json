{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/schemas/graph-signal.schema.json",
  "x-graphhelm-schema-version": "1.1.0",
  "title": "GraphHelm Graph Signal",
  "type": "object",
  "required": ["id", "source", "type", "severity", "description", "evidence", "emittedAt"],
  "properties": {
    "id": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["node", "runtime", "tool", "test", "user", "dream", "system"]},
        "id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "type": {"type": "string", "minLength": 1},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "description": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "emittedAt": {"type": "string", "format": "date-time"},
    "to": {"type": "string", "minLength": 1},
    "replyTo": {"type": "string", "minLength": 1}
    ,"proposal": {
      "type": "object",
      "required": ["id", "expectedVersion", "expectedHash", "operations"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "expectedVersion": {"type": "integer", "minimum": 1},
        "expectedHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "operations": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object"}},
        "manualOverride": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
