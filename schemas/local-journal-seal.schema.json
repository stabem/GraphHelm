{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/schemas/local-journal-seal.schema.json",
  "x-graphhelm-schema-version": "1.1.0",
  "title": "GraphHelm Local Journal Segment Seal",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "index", "bytes", "sha256", "keysSha256", "previousSeal", "endState"],
  "properties": {
    "formatVersion": {"const": "1.1.0"},
    "index": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
    "sha256": {"$ref": "#/$defs/hash"},
    "keysSha256": {"$ref": "#/$defs/hash"},
    "previousSeal": {"$ref": "#/$defs/hash"},
    "endState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextSequence", "lastHash", "activeVersions", "counters"],
      "properties": {
        "nextSequence": {
          "type": "object", "maxProperties": 250000,
          "propertyNames": {"pattern": "^[0-9a-f]{64}$"},
          "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        },
        "lastHash": {
          "type": "object", "maxProperties": 250000,
          "propertyNames": {"pattern": "^[0-9a-f]{64}$"},
          "additionalProperties": {"$ref": "#/$defs/hash"}
        },
        "activeVersions": {
          "type": "object", "maxProperties": 250000,
          "propertyNames": {"pattern": "^[0-9a-f]{64}$"},
          "additionalProperties": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "prefixItems": [
              {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
              {"$ref": "#/$defs/hash"},
              {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
              {"$ref": "#/$defs/hash"}
            ],
            "items": false
          }
        },
        "counters": {
          "type": "object", "additionalProperties": false,
          "required": ["batches", "events", "evidenceRefs", "evidenceRegistrations", "uniqueEvidence", "artifactRefs", "artifactRegistrations", "uniqueArtifacts", "graphPublications", "workUnits"],
          "properties": {
            "batches": {"$ref": "#/$defs/count"},
            "events": {"$ref": "#/$defs/count"},
            "evidenceRefs": {"$ref": "#/$defs/count"},
            "evidenceRegistrations": {"$ref": "#/$defs/count"},
            "uniqueEvidence": {"$ref": "#/$defs/count"},
            "artifactRefs": {"$ref": "#/$defs/count"},
            "artifactRegistrations": {"$ref": "#/$defs/count"},
            "uniqueArtifacts": {"$ref": "#/$defs/count"},
            "graphPublications": {"$ref": "#/$defs/count"},
            "workUnits": {"type": "integer", "minimum": 0, "maximum": 2000000}
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 250000}
  }
}
