{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/schemas/policy-waiver.schema.json",
  "x-graphhelm-schema-version": "1.0.0",
  "title": "GraphHelm Policy Waiver",
  "type": "object",
  "required": [
    "id",
    "requirement",
    "executionId",
    "graphVersion",
    "actor",
    "acknowledgedRisks",
    "scope",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "id": {"$ref": "#/$defs/opaqueId"},
    "requirement": {"$ref": "#/$defs/opaqueId"},
    "executionId": {"$ref": "#/$defs/opaqueId"},
    "graphVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "actor": {"$ref": "#/$defs/actorId"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
    "acknowledgedRisks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "scope": {"enum": ["node", "branch", "execution"]},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "expiresAt": {
      "oneOf": [
        {"$ref": "#/$defs/timestamp"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]{1,128}$"
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)(?:\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
