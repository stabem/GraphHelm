{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p50.dev/schemas/node.schema.json",
  "x-graphhelm-schema-version": "1.0.0",
  "title": "GraphHelm Graph Node",
  "type": "object",
  "required": ["type", "name", "objective", "optionality"],
  "properties": {
    "type": {"enum": ["agent", "tool", "classifier", "planner", "gate", "evaluator", "fork", "join", "human_decision", "timer", "trigger", "subgraph", "materializer", "deploy", "rollback", "artifact_transform"]},
    "name": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "optionality": {"enum": ["required", "recommended", "optional"]},
    "agent": {"oneOf": [{"type": "object", "required": ["ref"], "properties": {"ref": {"type": "string"}}, "additionalProperties": true}, {"type": "object", "required": ["ephemeral"], "properties": {"ephemeral": {"$ref": "agent.schema.json"}}, "additionalProperties": false}]},
    "model": {"type": "object", "additionalProperties": true},
    "input": {"type": "object", "additionalProperties": true},
    "output": {"type": "object", "additionalProperties": true},
    "context": {"type": "object", "additionalProperties": true},
    "permissions": {"type": "array", "items": {"type": ["string", "object"]}},
    "isolation": {"type": "object", "properties": {"minimum": {"enum": ["tier_0", "tier_1", "tier_2", "tier_3"]}}, "additionalProperties": true},
    "completion": {"type": "object", "additionalProperties": true},
    "retry": {"type": "object", "additionalProperties": true},
    "timeoutSeconds": {"type": "integer", "minimum": 1},
    "userEditable": {"type": "boolean"},
    "userOverrideAllowed": {"type": "boolean"},
    "resources": {"type": "object", "additionalProperties": true},
    "memory": {"type": "object", "additionalProperties": true},
    "ui": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "agent"}}}, "then": {"required": ["agent"]}},
    {"if": {"properties": {"type": {"const": "gate"}}}, "then": {"required": ["completion"]}}
  ],
  "additionalProperties": true
}
